<?xml version="1.0" encoding="utf-8"?>
<!-- Step 2 "Ziel" (docs/entwuerfe/schritt-2-ziel.md, stage C): kinds and files on the left, the paths in the
     middle, the output settings on the right. Pure XAML; the drawn orbit and the universes follow with
     Win2D (ADR-018). Colours only from Themes/KvertisColors.xaml. -->
<Page
  x:Class="Kvertis.App.Views.TargetPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
  xmlns:target="using:Kvertis.App.ViewModels.Target"
  NavigationCacheMode="Required">

  <Page.Resources>
    <!-- The ring is a Slider with its own template, so focus, keyboard (arrow keys +/- 5) and the narrator
         work without extra code (docs/entwuerfe/schritt-2-ziel.md, stage C). -->
    <Style x:Key="GradeRingSliderStyle" TargetType="Slider">
      <Setter Property="IsThumbToolTipEnabled" Value="False" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="IsFocusEngagementEnabled" Value="False" />
      <Setter Property="Width" Value="152" />
      <Setter Property="Height" Value="152" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid x:Name="SliderContainer" Background="Transparent">
              <Grid x:Name="HorizontalTemplate">
                <Ellipse
                  Width="140"
                  Height="140"
                  Stroke="{ThemeResource KvLineBrush}"
                  StrokeThickness="10" />
                <Ellipse
                  Width="140"
                  Height="140"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="10" />
                <!-- The named parts the Slider looks for; they carry no visuals here. -->
                <Rectangle x:Name="HorizontalTrackRect" Height="0" />
                <Rectangle x:Name="HorizontalDecreaseRect" Height="0" />
                <primitives:Thumb
                  x:Name="HorizontalThumb"
                  Width="0"
                  Height="0"
                  Opacity="0" />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="KindItemTemplate" x:DataType="target:KindGroupViewModel">
      <Grid
        AutomationProperties.Name="{x:Bind AutomationName}"
        ColumnSpacing="10"
        Padding="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse
          Width="12"
          Height="12"
          VerticalAlignment="Center"
          Fill="{x:Bind helpers:Ui.Brush(ColorBrushKey)}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Style="{StaticResource BodyStrongTextBlockStyle}"
          Text="{x:Bind KindName}" />
        <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind CountText, Mode=OneWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TargetFileTemplate" x:DataType="target:TargetFileViewModel">
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="12">
        <StackPanel Spacing="4">
          <TextBlock
            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind FileName}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SizeText}" />
          <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind DetailsText}"
            Visibility="{x:Bind helpers:Ui.ShowText(DetailsText)}" />
          <TextBlock
            Foreground="{ThemeResource KvVideoBrush}"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind WarningText}"
            Visibility="{x:Bind helpers:Ui.ShowText(WarningText)}" />
          <ComboBox
            AutomationProperties.Name="{x:Bind FileName}"
            DisplayMemberPath="Label"
            ItemsSource="{x:Bind Formats}"
            SelectedItem="{x:Bind OwnFormat, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Ui.Show(IsIndividual), Mode=OneWay}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PathRowTemplate" x:DataType="target:PathRowViewModel">
      <Grid
        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
        ColumnSpacing="8"
        Padding="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Style="{StaticResource BodyTextBlockStyle}"
          Text="{x:Bind FileName}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="1"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind TargetLabel, Mode=OneWay}" />
        <TextBlock
          Grid.Column="2"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind EstimateText, Mode=OneWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EffectTemplate" x:DataType="target:EffectViewModel">
      <Grid ColumnSpacing="8" Padding="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          FontSize="14"
          Foreground="{x:Bind helpers:Ui.Brush(BrushKey)}"
          Glyph="{x:Bind Glyph}" />
        <TextBlock
          Grid.Column="1"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind Text}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="WideLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="LeftColumn.Width" Value="*" />
            <Setter Target="MiddleColumn.Width" Value="0" />
            <Setter Target="RightColumn.Width" Value="0" />
            <Setter Target="MiddlePanel.(Grid.Column)" Value="0" />
            <Setter Target="MiddlePanel.(Grid.Row)" Value="1" />
            <Setter Target="RightPanel.(Grid.Column)" Value="0" />
            <Setter Target="RightPanel.(Grid.Row)" Value="2" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid Padding="24" ColumnSpacing="20" RowSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftColumn" Width="320" />
          <ColumnDefinition x:Name="MiddleColumn" Width="*" />
          <ColumnDefinition x:Name="RightColumn" Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: kinds and their files -->
        <StackPanel x:Name="LeftPanel" Spacing="12">
          <TextBlock x:Uid="Target_Title" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock
            x:Uid="Target_Empty_Text"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsEmpty), Mode=OneWay}" />
          <TextBlock x:Uid="Target_Kinds_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <ListView
            x:Uid="Target_Kinds_List"
            ItemTemplate="{StaticResource KindItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Kinds}"
            SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}"
            SelectionMode="Single" />

          <StackPanel DataContext="{x:Bind ViewModel.SelectedKind, Mode=OneWay}" Spacing="8">
            <Border
              Background="{ThemeResource KvMintSurfaceBrush}"
              BorderBrush="{ThemeResource KvMintFrameBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12"
              Visibility="{Binding IsLocked, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}">
              <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding LockTitle}" />
                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{Binding LockText}" />
              </StackPanel>
            </Border>

            <TextBlock x:Uid="Target_Mode_Header" Style="{StaticResource SectionHeaderTextStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <RadioButton
                x:Uid="Target_Mode_AllSame"
                GroupName="TargetMode"
                IsChecked="{Binding IsAllSame, Mode=TwoWay}" />
              <RadioButton
                x:Uid="Target_Mode_Individual"
                GroupName="TargetMode"
                IsChecked="{Binding IsIndividual, Mode=TwoWay}" />
            </StackPanel>

            <ItemsControl
              ItemTemplate="{StaticResource TargetFileTemplate}"
              ItemsSource="{Binding Files}" />
          </StackPanel>
        </StackPanel>

        <!-- Middle: one line per file, "source -> target, approximate size" -->
        <StackPanel
          x:Name="MiddlePanel"
          Grid.Column="1"
          DataContext="{x:Bind ViewModel.SelectedKind, Mode=OneWay}"
          Spacing="8">
          <TextBlock x:Uid="Target_Paths_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <Border Style="{StaticResource CardBorderStyle}">
            <ItemsControl ItemTemplate="{StaticResource PathRowTemplate}" ItemsSource="{Binding Paths}" />
          </Border>
        </StackPanel>

        <!-- Right: formats, ring, size bar, zones, exact size, more, what changes -->
        <StackPanel
          x:Name="RightPanel"
          Grid.Column="2"
          DataContext="{x:Bind ViewModel.SelectedKind, Mode=OneWay}"
          Spacing="12">

          <Border
            x:Name="PreviousCard"
            Background="{ThemeResource KvPanel2Brush}"
            BorderBrush="{ThemeResource KvLineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasPrevious), Mode=OneWay}">
            <StackPanel Spacing="6">
              <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Previous.TitleText, Mode=OneWay}" />
              <TextBlock
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.Previous.SummaryText, Mode=OneWay}" />
              <Button
                x:Uid="Target_Previous_Apply_Button"
                Command="{x:Bind ViewModel.Previous.ApplyCommand, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <Border
            Background="{ThemeResource KvMintSurfaceBrush}"
            BorderBrush="{ThemeResource KvMintFrameBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowBatchCard), Mode=OneWay}">
            <StackPanel Spacing="4">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.BatchCardTitle, Mode=OneWay}" />
              <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.BatchCardText, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <TextBlock x:Uid="Target_Formats_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <ComboBox
            x:Uid="Target_Format_ComboBox"
            HorizontalAlignment="Stretch"
            DisplayMemberPath="Label"
            ItemsSource="{Binding SharedFormats}"
            SelectedItem="{Binding SharedFormat, Mode=TwoWay}" />

          <StackPanel DataContext="{Binding Tuning}" Spacing="12">
            <!-- Ring: grade and word -->
            <StackPanel
              x:Name="GradeBlock"
              HorizontalAlignment="Center"
              Visibility="{Binding SupportsGrade, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}">
              <Grid Width="152" Height="152">
                <Slider
                  x:Uid="Target_Grade_Slider"
                  AutomationProperties.HelpText="{Binding GradeAutomationValue}"
                  Foreground="{Binding GradeBrushKey, Converter={StaticResource BrushKeyConverter}}"
                  LargeChange="10"
                  Maximum="100"
                  Minimum="0"
                  SmallChange="5"
                  Style="{StaticResource GradeRingSliderStyle}"
                  Value="{Binding Grade, Mode=TwoWay}" />
                <StackPanel
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
                  <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{Binding Grade}" />
                  <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{Binding BandText}" />
                  <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{Binding SizeText}" />
                </StackPanel>
              </Grid>
              <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{Binding PreviousText}"
                Visibility="{Binding HasPrevious, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}" />
            </StackPanel>

            <!-- Size bar -->
            <StackPanel
              x:Name="SizeBarBlock"
              Spacing="4"
              Visibility="{Binding SupportsGrade, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}">
              <TextBlock x:Uid="Target_SizeBar_Header" Style="{StaticResource SectionHeaderTextStyle}" />
              <Grid Width="320" HorizontalAlignment="Left">
                <ItemsControl
                  x:Name="SizeSegments"
                  Height="6"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding SizeBar.Segments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="target:SizeSegmentViewModel">
                      <Rectangle
                        Width="13.3"
                        Height="6"
                        Fill="{x:Bind helpers:Ui.Brush(BrushKey)}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Slider
                  x:Uid="Target_SizeBar_Slider"
                  AutomationProperties.HelpText="{Binding SizeBar.AutomationName}"
                  Background="Transparent"
                  LargeChange="50"
                  Maximum="{Binding SizeBar.Maximum}"
                  Minimum="0"
                  SmallChange="10"
                  Value="{Binding SizeBar.Position, Mode=TwoWay}" />
              </Grid>
              <Canvas Width="320" Height="18" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding SizeBar.Marks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="target:SizeMarkViewModel">
                      <TextBlock
                        Canvas.Left="{x:Bind Left}"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                  x:Uid="Target_Previous_Bar_Mark"
                  Canvas.Left="{Binding PreviousBarLeft}"
                  Canvas.Top="0"
                  Foreground="{ThemeResource KvMutedBrush}"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  Visibility="{Binding HasPrevious, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}" />
              </Canvas>
              <Grid>
                <TextBlock
                  HorizontalAlignment="Left"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  Text="{Binding SizeBar.MinText}" />
                <TextBlock
                  HorizontalAlignment="Right"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  Text="{Binding SizeBar.MaxText}" />
              </Grid>
            </StackPanel>

            <!-- Zones -->
            <ItemsControl ItemsSource="{Binding Zones}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="target:ZoneViewModel">
                  <Expander
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                    Margin="0,0,0,6">
                    <Expander.Header>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                          VerticalAlignment="Center"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                          Text="{x:Bind NameText}" />
                        <ProgressBar
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                          Foreground="{x:Bind helpers:Ui.Brush(BrushKey), Mode=OneWay}"
                          IsIndeterminate="False"
                          Maximum="100"
                          Minimum="0"
                          Value="{x:Bind Value, Mode=OneWay}" />
                        <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Style="{StaticResource SecondaryCaptionTextStyle}"
                          Text="{x:Bind DetailText, Mode=OneWay}" />
                      </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                      <Slider
                        AutomationProperties.Name="{x:Bind NameText}"
                        AutomationProperties.HelpText="{x:Bind AutomationName, Mode=OneWay}"
                        IsEnabled="{x:Bind Adjustable, Mode=OneWay}"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="5"
                        Value="{x:Bind Value, Mode=TwoWay}" />
                      <TextBlock
                        x:Uid="Target_Zone_Fixed_Text"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Visibility="{x:Bind helpers:Ui.Hide(Adjustable), Mode=OneWay}" />
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Exact target size -->
            <Expander x:Uid="Target_ExactSize_Expander" HorizontalAlignment="Stretch">
              <Expander.Header>
                <TextBlock x:Uid="Target_ExactSize_Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
              </Expander.Header>
              <StackPanel Spacing="8">
                <ToggleSwitch x:Uid="Target_ExactSize_Toggle" IsOn="{Binding ExactTargetEnabled, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumberBox
                    x:Uid="Target_ExactSize_NumberBox"
                    Width="140"
                    IsEnabled="{Binding ExactTargetEnabled}"
                    Minimum="0.1"
                    SpinButtonPlacementMode="Compact"
                    Value="{Binding ExactTargetMegabytes, Mode=TwoWay}" />
                  <TextBlock
                    x:Uid="Target_ExactSize_Unit"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>
                <TextBlock
                  x:Uid="Target_ExactSize_Hint"
                  Foreground="{ThemeResource KvVideoBrush}"
                  Style="{StaticResource SecondaryCaptionTextStyle}"
                  Visibility="{Binding ExactTargetUnreachable, Converter={StaticResource ShowConverter}, FallbackValue=Collapsed}" />
              </StackPanel>
            </Expander>

            <!-- More: metadata and file name -->
            <Expander x:Uid="Target_More_Expander" HorizontalAlignment="Stretch">
              <Expander.Header>
                <TextBlock x:Uid="Target_More_Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
              </Expander.Header>
              <StackPanel Spacing="8">
                <ToggleSwitch x:Uid="Target_Metadata_Toggle" IsOn="{Binding StripMetadata, Mode=TwoWay}" />
                <TextBlock x:Uid="Target_Metadata_Hint" Style="{StaticResource SecondaryCaptionTextStyle}" />
                <TextBox x:Uid="Target_NamePattern_TextBox" Text="{Binding NamePatternText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{Binding NamePreview}" />
              </StackPanel>
            </Expander>

            <!-- What changes -->
            <StackPanel Spacing="4">
              <TextBlock x:Uid="Target_Effects_Header" Style="{StaticResource SectionHeaderTextStyle}" />
              <ItemsRepeater ItemTemplate="{StaticResource EffectTemplate}" ItemsSource="{Binding Effects}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Bottom bar: trust line, summary, back and the only mint button of the page -->
    <Border
      Grid.Row="1"
      Background="{ThemeResource KvPanelBrush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="0,1,0,0"
      Padding="24,12">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <FontIcon FontSize="14" Glyph="&#xE72E;" />
          <TextBlock x:Uid="Target_Trust_Text" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        <StackPanel
          Grid.Column="2"
          Orientation="Horizontal"
          Spacing="8">
          <Button x:Uid="Target_Back_Button" Command="{x:Bind ViewModel.BackCommand}" />
          <Button
            x:Uid="Target_Continue_Button"
            MinWidth="160"
            MinHeight="40"
            Command="{x:Bind ViewModel.ContinueCommand}"
            Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
