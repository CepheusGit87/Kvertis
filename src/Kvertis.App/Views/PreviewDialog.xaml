<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="Kvertis.App.Views.PreviewDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  x:Uid="Preview_Dialog"
  DefaultButton="Close"
  Title="{x:Bind ViewModel.Title}">

  <!-- Before/after preview (docs/06-design.md, section 4). -->
  <StackPanel MinWidth="480" Spacing="12">
    <ProgressRing
      x:Uid="Preview_Loading_Progress"
      HorizontalAlignment="Center"
      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
      Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsLoading), Mode=OneWay}" />

    <Grid ColumnSpacing="12" Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsVisual)}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock x:Uid="Preview_Before_Label" Style="{StaticResource CaptionTextBlockStyle}" />
        <Image x:Name="BeforeImage" x:Uid="Preview_Before_Image" MaxHeight="320" Stretch="Uniform" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock x:Uid="Preview_After_Label" Style="{StaticResource CaptionTextBlockStyle}" />
        <Image x:Name="AfterImage" x:Uid="Preview_After_Image" MaxHeight="320" Stretch="Uniform" />
      </StackPanel>
    </Grid>

    <StackPanel Spacing="8" Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsAudio)}">
      <TextBlock x:Uid="Preview_Before_Label" Style="{StaticResource CaptionTextBlockStyle}" />
      <MediaPlayerElement x:Name="BeforePlayer" x:Uid="Preview_Before_Player" AreTransportControlsEnabled="True" />
      <TextBlock x:Uid="Preview_After_Excerpt_Label" Style="{StaticResource CaptionTextBlockStyle}" />
      <MediaPlayerElement x:Name="AfterPlayer" x:Uid="Preview_After_Player" AreTransportControlsEnabled="True" />
    </StackPanel>

    <TextBlock
      AutomationProperties.LiveSetting="Polite"
      Style="{StaticResource BodyStrongTextBlockStyle}"
      Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
      TextWrapping="Wrap" />
    <TextBlock
      AutomationProperties.LiveSetting="Assertive"
      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
      Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
      TextWrapping="Wrap"
      Visibility="{x:Bind helpers:Ui.ShowText(ViewModel.ErrorText), Mode=OneWay}" />
  </StackPanel>
</ContentDialog>
