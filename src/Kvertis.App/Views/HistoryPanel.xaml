<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Kvertis.App.Views.HistoryPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:vm="using:Kvertis.App.ViewModels">

  <!-- History side panel (docs/06-design.md, section 5). Local only, can be cleared. -->
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Uid="History_Title" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Button x:Uid="History_Clear_Button" Grid.Column="1" Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}" />
      <Button
        x:Uid="History_Close_Button"
        Grid.Column="2"
        Width="{StaticResource IconButtonSize}"
        Height="{StaticResource IconButtonSize}"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Click="OnCloseClick">
        <FontIcon FontSize="12" Glyph="&#xE711;" />
      </Button>
    </Grid>

    <TextBlock
      x:Uid="History_Empty_Text"
      Grid.Row="1"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsEmpty), Mode=OneWay}" />

    <ListView
      x:Uid="History_List"
      Grid.Row="1"
      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
      SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0,6" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:HistoryItemViewModel">
          <Grid AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="14" Glyph="{x:Bind StatusGlyph}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind FormatText}" />
              <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SettingsText}" />
              <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind WhenText}" />
              <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ResultText}" />
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="History_Again_Button" Command="{x:Bind AgainCommand}" />
                <Button x:Uid="History_OpenFolder_Button" Command="{x:Bind OpenFolderCommand}" Visibility="{x:Bind helpers:Ui.Show(HasOutput)}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
