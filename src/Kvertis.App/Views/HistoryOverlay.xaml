<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Kvertis.App.Views.HistoryOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  xmlns:vm="using:Kvertis.App.ViewModels">

  <!-- History as a full-window overlay under the title bar (draft .verlauf, inset 42 0 0 0), laid out after
       "Zusammengeführt" in design/verlauf-konzepte.html: head with filters (.v-kopf), search (.k6-such),
       timeline on the left (.k6-liste, .k1-tag, .k1-run, .k6-karte), the chosen entry on the right (.k4-detail).
       Filter, search and selection live in HistoryViewModel; this file only shows them. -->
  <UserControl.Resources>
    <!-- Source is set in code-behind once the view model arrives (grouped by local day). -->
    <CollectionViewSource x:Key="DayGroups" IsSourceGrouped="True" />

    <!-- The card shows hover and selection itself; the list draws no highlight and no selection pill. -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

    <!-- .k4-zahl: box with a small caption and a mono number. -->
    <Style x:Key="NumberBoxStyle" TargetType="Border">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{ThemeResource KvPanelBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource KvLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="NumberCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource KvSmallTextStyle}">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="NumberValueStyle" TargetType="TextBlock" BasedOn="{StaticResource KvTextBaseStyle}">
      <Setter Property="FontFamily" Value="{StaticResource KvMonoFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- .k4-einst dt / dd: 12.5, term muted, value 500 ink. -->
    <Style x:Key="TermStyle" TargetType="TextBlock" BasedOn="{StaticResource KvTextBaseStyle}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{ThemeResource KvMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource KvTextBaseStyle}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- .vk.gross: secondary action of the detail bar (border line, panel, radius 9, 12 / Medium, symbol 14). -->
    <Style x:Key="DetailActionButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="{ThemeResource KvPanelBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid
    x:Name="Root"
    x:Uid="History_Overlay"
    Background="{ThemeResource KvBackgroundBrush}"
    KeyDown="OnRootKeyDown"
    SizeChanged="OnRootSizeChanged"
    TabFocusNavigation="Cycle"
    Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .v-kopf: 12,22, gap 10/14, line below, panel 45 %: close, title, local note, filters, clear. -->
    <Border
      Grid.Row="0"
      Padding="22,12"
      Background="{ThemeResource KvPanel45Brush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="0,0,0,1">
      <Grid x:Name="HeadGrid" ColumnSpacing="14" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
          x:Name="CloseButton"
          x:Uid="History_Close_Button"
          Grid.Column="0"
          VerticalAlignment="Center"
          Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
              AutomationProperties.AccessibilityView="Raw"
              FontSize="12"
              Glyph="&#xE72B;" />
            <TextBlock x:Uid="History_Close_Text" />
          </StackPanel>
        </Button>

        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="14">
          <TextBlock
            x:Uid="History_Title"
            VerticalAlignment="Center"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource KvTitleTextStyle}" />
          <StackPanel
            x:Name="LocalNote"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <FontIcon
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              FontSize="13"
              Foreground="{ThemeResource KvMintBrush}"
              Glyph="&#xE72E;" />
            <TextBlock
              x:Uid="History_Local_Text"
              VerticalAlignment="Center"
              FontSize="12"
              Style="{StaticResource KvSmallTextStyle}" />
          </StackPanel>
        </StackPanel>

        <!-- .segment: deep, line, radius 10, padding 3; buttons 12 muted, 5,10, radius 7, 8 px square in the kind colour. -->
        <Border
          x:Name="FilterBar"
          Grid.Column="3"
          Padding="3"
          VerticalAlignment="Center"
          Style="{StaticResource KvSegmentBarStyle}">
          <ItemsControl x:Uid="History_Filters" IsTabStop="False" ItemsSource="{x:Bind ViewModel.Filters, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryFilterOption">
                <RadioButton
                  Padding="10,5"
                  AutomationProperties.Name="{x:Bind Label}"
                  CornerRadius="7"
                  GroupName="HistoryFilter"
                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                  Style="{StaticResource KvSegmentStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border
                      Width="8"
                      Height="8"
                      VerticalAlignment="Center"
                      Background="{x:Bind helpers:Ui.Brush(DotBrushKey)}"
                      CornerRadius="2"
                      Visibility="{x:Bind helpers:Ui.Show(HasDot)}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Button
          x:Uid="History_Clear_Button"
          Grid.Column="4"
          VerticalAlignment="Center"
          Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}" />
      </Grid>
    </Border>

    <!-- .k6-such: 10,18, line below, panel 30 %; label 11.5 muted over the box (372 wide, radius 10, line-stark,
         panel, magnifier left), the match line beside it (11.5 mono muted, number mint). -->
    <Border
      Grid.Row="1"
      Padding="18,10"
      Background="{ThemeResource KvPanel30Brush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="0,0,0,1"
      Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasItems), Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock
            x:Name="SearchLabel"
            x:Uid="History_Search_Label"
            FontSize="11.5"
            Style="{StaticResource KvSmallTextStyle}" />
          <Grid Width="372">
            <TextBox
              x:Name="SearchBox"
              x:Uid="History_Search_Box"
              Padding="34,7,8,7"
              AutomationProperties.LabeledBy="{x:Bind SearchLabel}"
              Background="{ThemeResource KvPanelBrush}"
              BorderBrush="{ThemeResource KvLineStrongBrush}"
              CornerRadius="10"
              FontFamily="{StaticResource KvFontFamily}"
              FontSize="13"
              InputScope="Search"
              IsSpellCheckEnabled="False"
              KeyDown="OnSearchKeyDown"
              Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource KvPanelColor}" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource KvPanelColor}" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource KvLineStrongColor}" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource KvMintColor}" />
              </TextBox.Resources>
            </TextBox>
            <FontIcon
              Margin="11,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              FontSize="14"
              Foreground="{ThemeResource KvMutedBrush}"
              Glyph="&#xE721;"
              IsHitTestVisible="False" />
          </Grid>
        </StackPanel>
        <TextBlock
          x:Name="MatchLine"
          Margin="0,0,0,9"
          VerticalAlignment="Bottom"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{x:Bind ViewModel.MatchText, Mode=OneWay}"
          FontSize="11.5"
          Style="{StaticResource KvMonoTextStyle}">
          <Run FontWeight="SemiBold" Foreground="{ThemeResource KvMintBrush}" Text="{x:Bind ViewModel.MatchCountText, Mode=OneWay}" />
          <Run Text="{x:Bind ViewModel.MatchSuffixText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- .v-leer: nothing converted yet; clock, 15 ink, one muted line, centred. -->
    <StackPanel
      Grid.Row="2"
      Padding="20,70"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Spacing="8"
      Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsEmpty), Mode=OneWay}">
      <FontIcon
        AutomationProperties.AccessibilityView="Raw"
        FontSize="28"
        Foreground="{ThemeResource KvQuietBrush}"
        Glyph="&#xE81C;" />
      <TextBlock
        x:Uid="History_Empty_Title"
        HorizontalAlignment="Center"
        FontSize="15"
        FontWeight="SemiBold"
        Style="{StaticResource KvTextBaseStyle}"
        TextAlignment="Center" />
      <TextBlock
        x:Uid="History_Empty_Text"
        HorizontalAlignment="Center"
        FontSize="12.5"
        Style="{StaticResource KvSmallTextStyle}"
        TextAlignment="Center"
        TextTrimming="None"
        TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="2" Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasItems), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="410" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- .k6-liste: 0,16,18,4; line right; panel 25 % (the nearest mixed brush is 30 %). -->
      <Border
        Grid.Column="0"
        Background="{ThemeResource KvPanel30Brush}"
        BorderBrush="{ThemeResource KvLineBrush}"
        BorderThickness="0,0,1,0">
        <Grid>
          <ListView
            x:Name="EntryList"
            x:Uid="History_List"
            Padding="4,0,4,18"
            IsItemClickEnabled="False"
            ItemsSource="{Binding Source={StaticResource DayGroups}}"
            SelectionChanged="OnEntrySelectionChanged"
            SelectionMode="Single"
            SingleSelectionFollowsFocus="True">
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderContainerStyle>
                  <Style TargetType="ListViewHeaderItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewHeaderItem">
                          <ContentPresenter
                            HorizontalContentAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.HeaderContainerStyle>
                <GroupStyle.HeaderTemplate>
                  <!-- .k1-tk: sticky, 14,0,10,94, 13.5 SemiBold plus the date in mono 11 quiet; background bg fading
                       out below 78 %. .k1-tp: 16 square, radius 5, panel2 with a 2 px mint ring at x 64; the day line
                       (.k1-tag::before) starts under it. -->
                  <DataTemplate x:DataType="vm:HistoryDayGroup">
                    <Grid Height="46">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <!-- Covers the cards that scroll under the sticky title; the lower 10 px stay open. -->
                      <Border Background="{ThemeResource KvBackgroundBrush}" />
                      <Rectangle
                        Grid.RowSpan="2"
                        Width="2"
                        Margin="71,26,0,0"
                        HorizontalAlignment="Left"
                        Fill="{ThemeResource KvMintFrameBrush}" />
                      <Border
                        Grid.RowSpan="2"
                        Width="16"
                        Height="16"
                        Margin="64,17,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource KvPanel2Brush}"
                        BorderBrush="{ThemeResource KvMintBrush}"
                        BorderThickness="2"
                        CornerRadius="5" />
                      <StackPanel
                        Grid.RowSpan="2"
                        Margin="94,14,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource KvHeadTextStyle}" Text="{x:Bind Title}" />
                        <TextBlock
                          VerticalAlignment="Bottom"
                          FontSize="11"
                          Foreground="{ThemeResource KvQuietBrush}"
                          Style="{StaticResource KvMonoTextStyle}"
                          Text="{x:Bind Subtitle}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <!-- .k1-run: time 58 | node 28 | card; gap 8 between runs. Time 12 mono SemiBold right, muted (ink when
                   chosen); node 12 with a 2 px ring in the kind colour and a 3 px halo in bg, filled when chosen.
                   The 2 px day line runs through the node column. -->
              <DataTemplate x:DataType="vm:HistoryItemViewModel">
                <Grid AutomationProperties.Name="{x:Bind AutomationName}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Rectangle
                    Grid.Column="1"
                    Width="2"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource KvMintFrameBrush}" />
                  <Ellipse
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{x:Bind helpers:Ui.Brush(StatusBrushKey)}"
                    Opacity="{ThemeResource KvGlowOpacity}"
                    Visibility="{x:Bind helpers:Ui.Show(IsSelected), Mode=OneWay}" />
                  <Ellipse
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    Margin="0,19,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource KvBackgroundBrush}"
                    Visibility="{x:Bind helpers:Ui.Hide(IsSelected), Mode=OneWay}" />
                  <Ellipse
                    Grid.Column="1"
                    Width="12"
                    Height="12"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{x:Bind views:HistoryOverlay.NodeFill(IsSelected, StatusBrushKey), Mode=OneWay}"
                    Stroke="{x:Bind helpers:Ui.Brush(StatusBrushKey)}"
                    StrokeThickness="2" />
                  <TextBlock
                    Grid.Column="0"
                    Margin="0,19,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind helpers:Ui.BrushIf(IsSelected, 'KvInkBrush', 'KvMutedBrush'), Mode=OneWay}"
                    Style="{StaticResource KvMonoTextStyle}"
                    Text="{x:Bind TimeText}" />

                  <!-- .k6-karte: status 20 | text | pill, gap 10, 8,10, radius 12, line, gradient, inner edge, shadow;
                       hover line-stark; chosen: mint-rahmen, 5 px to the right and a notch pointing at the detail. The list item clips
                       its content, so the shift and the notch live in a 12 px right margin instead of a transform. -->
                  <Grid Grid.Column="2" Margin="{x:Bind views:HistoryOverlay.CardMargin(IsSelected), Mode=OneWay}">
                    <Border
                      x:Name="Card"
                      Padding="0"
                      BorderBrush="{x:Bind helpers:Ui.BrushIf(IsSelected, 'KvMintFrameBrush', 'KvLineBrush'), Mode=OneWay}"
                      CornerRadius="12"
                      Loaded="OnCardLoaded"
                      PointerCanceled="OnCardPointerExited"
                      PointerEntered="OnCardPointerEntered"
                      PointerExited="OnCardPointerExited"
                      Style="{StaticResource KvCardStyle}">
                      <Border
                        Padding="10,8"
                        BorderBrush="{ThemeResource KvEdgeBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="11">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{x:Bind helpers:Ui.Brush(StatusBrushKey)}"
                            Glyph="{x:Bind StatusGlyph}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                              FontSize="13"
                              Style="{StaticResource KvHeadTextStyle}"
                              Text="{x:Bind TitleText}"
                              TextTrimming="CharacterEllipsis" />
                            <TextBlock
                              FontWeight="Normal"
                              Foreground="{x:Bind helpers:Ui.BrushIf(Success, 'KvMutedBrush', 'KvErrorBrush')}"
                              Style="{StaticResource KvMonoTextStyle}"
                              Text="{x:Bind DetailText}"
                              TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border
                            Grid.Column="2"
                            Padding="7,1"
                            Style="{StaticResource KvPillStyle}"
                            Visibility="{x:Bind helpers:Ui.Show(HasSaving)}">
                            <TextBlock
                              FontSize="11"
                              Style="{StaticResource KvPillTextStyle}"
                              Text="{x:Bind SavingText}" />
                          </Border>
                        </Grid>
                      </Border>
                    </Border>
                    <Border
                      Width="12"
                      Height="12"
                      Margin="0,0,-7,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Background="{ThemeResource KvPanelBrush}"
                      BorderBrush="{ThemeResource KvMintFrameBrush}"
                      BorderThickness="0,1,1,0"
                      RenderTransformOrigin="0.5,0.5"
                      Visibility="{x:Bind helpers:Ui.Show(IsSelected), Mode=OneWay}">
                      <Border.RenderTransform>
                        <RotateTransform Angle="45" />
                      </Border.RenderTransform>
                    </Border>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- Nothing passes filter and search: say so and offer the way back. -->
          <StackPanel
            Padding="20,60"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.NoMatches), Mode=OneWay}">
            <TextBlock
              x:Uid="History_NoMatch_Title"
              HorizontalAlignment="Center"
              FontSize="15"
              FontWeight="SemiBold"
              Style="{StaticResource KvTextBaseStyle}"
              TextAlignment="Center" />
            <TextBlock
              x:Uid="History_NoMatch_Text"
              HorizontalAlignment="Center"
              FontSize="12.5"
              Style="{StaticResource KvSmallTextStyle}"
              TextAlignment="Center"
              TextTrimming="None"
              TextWrapping="Wrap" />
            <Button
              x:Uid="History_ResetFilters_Button"
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              Command="{x:Bind ViewModel.ResetFiltersCommand, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- .k4-detail: scrolling body (16,22,18, gap 16) over the action bar (12,22,14, line above, panel 55 %). -->
      <Grid Grid.Column="1" Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasSelection), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
          x:Uid="History_Detail"
          Grid.Row="0"
          HorizontalScrollMode="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="22,16,22,18" Spacing="16">

            <!-- .k4-dk: stack of sheets (32 x 28, count pill), stamp 11 mono quiet, name 18 SemiBold, savings 14. -->
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid
                Width="32"
                Height="28"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw">
                <Border Width="23" Height="17" Margin="0,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource KvPaperBrush}" BorderBrush="{ThemeResource KvShadowBrush}" BorderThickness="0,0,0,1" CornerRadius="2" />
                <Border Width="8" Height="3" Margin="3,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Bind helpers:Ui.Brush(ViewModel.Selected.KindBrushKey), Mode=OneWay}" CornerRadius="2,2,0,0" />
                <Border Width="23" Height="17" Margin="3,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource KvPaperBrush}" BorderBrush="{ThemeResource KvShadowBrush}" BorderThickness="0,0,0,1" CornerRadius="2" />
                <Border Width="8" Height="3" Margin="6,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Bind helpers:Ui.Brush(ViewModel.Selected.KindBrushKey), Mode=OneWay}" CornerRadius="2,2,0,0" />
                <Border Width="23" Height="17" Margin="6,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource KvPaperBrush}" BorderBrush="{ThemeResource KvShadowBrush}" BorderThickness="0,0,0,1" CornerRadius="2" />
                <Border Width="8" Height="3" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Bind helpers:Ui.Brush(ViewModel.Selected.KindBrushKey), Mode=OneWay}" CornerRadius="2,2,0,0" />
                <Border
                  MinWidth="16"
                  Height="16"
                  Margin="0,0,-4,-3"
                  Padding="4,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="{x:Bind helpers:Ui.Brush(ViewModel.Selected.StatusBrushKey), Mode=OneWay}"
                  CornerRadius="8">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource KvMonoFontFamily}"
                    FontSize="9.5"
                    FontWeight="Bold"
                    Foreground="{ThemeResource KvPaperInkBrush}"
                    Text="1" />
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                  CharacterSpacing="40"
                  FontSize="11"
                  Foreground="{ThemeResource KvQuietBrush}"
                  Style="{StaticResource KvMonoTextStyle}"
                  Text="{x:Bind ViewModel.Selected.Pane.Stamp, Mode=OneWay}" />
                <TextBlock
                  AutomationProperties.HeadingLevel="Level2"
                  CharacterSpacing="-10"
                  FontSize="18"
                  FontWeight="SemiBold"
                  Style="{StaticResource KvTextBaseStyle}"
                  Text="{x:Bind ViewModel.Selected.FileName, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border
                Grid.Column="2"
                Padding="12,4"
                Style="{StaticResource KvPillStyle}"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.Selected.HasSaving), Mode=OneWay}">
                <TextBlock
                  FontSize="14"
                  Style="{StaticResource KvPillTextStyle}"
                  Text="{x:Bind ViewModel.Selected.SavingText, Mode=OneWay}" />
              </Border>
            </Grid>

            <!-- A failed job: what happened and what helps (the error texts of the engine code). -->
            <Border
              Padding="14,10"
              Background="{ThemeResource KvPanelBrush}"
              BorderBrush="{ThemeResource KvErrorFrameBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Visibility="{x:Bind helpers:Ui.Show(ViewModel.Selected.Failed), Mode=OneWay}">
              <StackPanel Spacing="4">
                <TextBlock
                  FontSize="13"
                  Foreground="{ThemeResource KvErrorBrush}"
                  Style="{StaticResource KvHeadTextStyle}"
                  Text="{x:Bind ViewModel.Selected.Pane.ErrorTitle, Mode=OneWay}"
                  TextWrapping="Wrap" />
                <TextBlock
                  FontSize="12"
                  Style="{StaticResource KvSmallTextStyle}"
                  Text="{x:Bind ViewModel.Selected.Pane.ErrorBody, Mode=OneWay}"
                  TextTrimming="None"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- .k4-wandel: 16,18, radius 14, line; kind tint; a 5 px ledge in the kind colour below (0 10px 0 -5px).
                 Chip 15 SemiBold (5,12, radius 7), long mint arrow, paper label 15 turned by -2 degrees. -->
            <Grid Margin="0,0,0,5">
              <Border
                Margin="5,0,5,-5"
                Background="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Frame40'), Mode=OneWay}"
                CornerRadius="14" />
              <Border
                Padding="18,16"
                Background="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Tint12'), Mode=OneWay}"
                BorderBrush="{ThemeResource KvLineBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border
                    Padding="12,5"
                    VerticalAlignment="Center"
                    Background="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Tint12'), Mode=OneWay}"
                    BorderBrush="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Frame40'), Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <TextBlock
                      FontFamily="{StaticResource KvMonoFontFamily}"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Foreground="{x:Bind helpers:Ui.Brush(ViewModel.Selected.KindBrushKey), Mode=OneWay}"
                      Text="{x:Bind ViewModel.Selected.InputFormatText, Mode=OneWay}" />
                  </Border>
                  <FontIcon
                    Width="30"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Foreground="{ThemeResource KvMintBrush}"
                    Glyph="&#xE72A;" />
                  <ContentControl
                    Padding="14,6"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource KvPaperTagStyle}">
                    <ContentControl.RenderTransform>
                      <RotateTransform Angle="-0.8" />
                    </ContentControl.RenderTransform>
                    <TextBlock
                      FontSize="15"
                      Style="{StaticResource KvPaperTagTextStyle}"
                      Text="{x:Bind ViewModel.Selected.OutputFormatText, Mode=OneWay}" />
                  </ContentControl>
                </StackPanel>
              </Border>
            </Grid>

            <!-- .k4-zahlen: before, after, saved (mint); below the bar (8, radius 4, deep, mint = after of before). -->
            <Grid ColumnSpacing="10" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Column="0" Style="{StaticResource NumberBoxStyle}">
                <StackPanel Spacing="2">
                  <TextBlock x:Uid="History_Detail_Before" Style="{StaticResource NumberCaptionStyle}" />
                  <TextBlock Style="{StaticResource NumberValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.BytesIn, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource NumberBoxStyle}">
                <StackPanel Spacing="2">
                  <TextBlock x:Uid="History_Detail_After" Style="{StaticResource NumberCaptionStyle}" />
                  <TextBlock Style="{StaticResource NumberValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.BytesOut, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource NumberBoxStyle}">
                <StackPanel Spacing="2">
                  <TextBlock x:Uid="History_Detail_Saved" Style="{StaticResource NumberCaptionStyle}" />
                  <TextBlock
                    Foreground="{ThemeResource KvMintBrush}"
                    Style="{StaticResource NumberValueStyle}"
                    Text="{x:Bind ViewModel.Selected.Pane.Saved, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="8"
                Background="{ThemeResource KvDeepBrush}"
                BorderBrush="{ThemeResource KvLineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.Selected.Success), Mode=OneWay}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind views:HistoryOverlay.StarFilled(ViewModel.Selected.Pane.OutRatio), Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind views:HistoryOverlay.StarRest(ViewModel.Selected.Pane.OutRatio), Mode=OneWay}" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{ThemeResource KvMintBrush}" CornerRadius="3" />
                </Grid>
              </Border>
            </Grid>

            <!-- .k4-einst: term | value | term | value, gap 8 / 14, 12.5. Quality with a 90 x 6 meter. -->
            <Grid ColumnSpacing="14" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock x:Uid="History_Detail_Purpose" Grid.Row="0" Grid.Column="0" Style="{StaticResource TermStyle}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.Purpose, Mode=OneWay}" />
              <TextBlock x:Uid="History_Detail_Quality" Grid.Row="0" Grid.Column="2" Style="{StaticResource TermStyle}" />
              <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Border
                  Width="90"
                  Height="6"
                  VerticalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw"
                  Background="{ThemeResource KvDeepBrush}"
                  BorderBrush="{ThemeResource KvLineBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
                  <Border
                    Width="{x:Bind views:HistoryOverlay.MeterWidth(ViewModel.Selected.Pane.QualityRatio), Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource KvMintBrush}" />
                </Border>
                <TextBlock Style="{StaticResource ValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.Quality, Mode=OneWay}" />
              </StackPanel>

              <TextBlock x:Uid="History_Detail_Duration" Grid.Row="1" Grid.Column="0" Style="{StaticResource TermStyle}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.Duration, Mode=OneWay}" />
              <TextBlock x:Uid="History_Detail_Metadata" Grid.Row="1" Grid.Column="2" Style="{StaticResource TermStyle}" />
              <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.Metadata, Mode=OneWay}" />

              <TextBlock x:Uid="History_Detail_Location" Grid.Row="2" Grid.Column="0" Style="{StaticResource TermStyle}" />
              <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                  VerticalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw"
                  FontSize="14"
                  Foreground="{ThemeResource KvMutedBrush}"
                  Glyph="&#xE8B7;" />
                <TextBlock Style="{StaticResource ValueStyle}" Text="{x:Bind ViewModel.Selected.Pane.Location, Mode=OneWay}" />
              </StackPanel>
            </Grid>

            <!-- .k4-abschnitt, then .vd-liste with the one .vd row: chip, mint arrow, label, name and folder, sizes. -->
            <TextBlock x:Uid="History_Detail_Files" Margin="0,0,0,-8" Style="{StaticResource KvLabelTextStyle}" />
            <Border
              Padding="10,7"
              Background="{ThemeResource KvPanelBrush}"
              BorderBrush="{ThemeResource KvLineBrush}"
              BorderThickness="1"
              CornerRadius="10">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="50" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="Auto" MinWidth="58" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                  Grid.Column="0"
                  Padding="6,1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Tint12'), Mode=OneWay}"
                  BorderBrush="{x:Bind helpers:Ui.KindVariant(ViewModel.Selected.KindBrushKey, 'Frame40'), Mode=OneWay}"
                  BorderThickness="1"
                  CornerRadius="4">
                  <TextBlock
                    FontFamily="{StaticResource KvMonoFontFamily}"
                    FontSize="10.5"
                    FontWeight="Medium"
                    Foreground="{x:Bind helpers:Ui.Brush(ViewModel.Selected.KindBrushKey), Mode=OneWay}"
                    Text="{x:Bind ViewModel.Selected.InputFormatText, Mode=OneWay}" />
                </Border>
                <FontIcon
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw"
                  FontSize="11"
                  Foreground="{ThemeResource KvMintBrush}"
                  Glyph="&#xE72A;" />
                <ContentControl
                  Grid.Column="2"
                  Padding="7,2"
                  HorizontalAlignment="Left"
                  Style="{StaticResource KvPaperTagStyle}">
                  <TextBlock
                    FontSize="10.5"
                    Style="{StaticResource KvPaperTagTextStyle}"
                    Text="{x:Bind ViewModel.Selected.OutputFormatText, Mode=OneWay}" />
                </ContentControl>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock
                    FontSize="12"
                    Style="{StaticResource KvRowTextStyle}"
                    Text="{x:Bind ViewModel.Selected.FileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    FontWeight="Normal"
                    Style="{StaticResource KvMonoTextStyle}"
                    Text="{x:Bind ViewModel.Selected.Pane.InputFolder, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                  Grid.Column="4"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Style="{StaticResource KvMonoTextStyle}">
                  <Run Text="{x:Bind ViewModel.Selected.Pane.BytesIn, Mode=OneWay}" />
                  <Run Foreground="{ThemeResource KvMintBrush}" Text="→" />
                  <Run
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource KvInkBrush}"
                    Text="{x:Bind ViewModel.Selected.Pane.BytesOut, Mode=OneWay}" />
                </TextBlock>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- .k4-akt: again (primary), open folder, show in folder. -->
        <Border
          Grid.Row="1"
          Padding="22,12,22,14"
          Background="{ThemeResource KvPanel55Brush}"
          BorderBrush="{ThemeResource KvLineBrush}"
          BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button
              x:Uid="History_Again_Button"
              MinWidth="0"
              Command="{x:Bind ViewModel.AgainCommand, Mode=OneWay}"
              Style="{StaticResource KvPrimaryButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                  AutomationProperties.AccessibilityView="Raw"
                  FontSize="16"
                  Glyph="&#xE72C;" />
                <TextBlock x:Uid="History_Again_Text" />
              </StackPanel>
            </Button>
            <Button
              x:Uid="History_OpenFolder_Button"
              Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}"
              Style="{StaticResource DetailActionButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                  AutomationProperties.AccessibilityView="Raw"
                  FontSize="14"
                  Glyph="&#xE838;" />
                <TextBlock x:Uid="History_OpenFolder_Text" />
              </StackPanel>
            </Button>
            <Button
              x:Uid="History_ShowInFolder_Button"
              Command="{x:Bind ViewModel.ShowInFolderCommand, Mode=OneWay}"
              Style="{StaticResource DetailActionButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                  AutomationProperties.AccessibilityView="Raw"
                  FontSize="14"
                  Glyph="&#xE8A7;" />
                <TextBlock x:Uid="History_ShowInFolder_Text" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
