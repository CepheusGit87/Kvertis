<?xml version="1.0" encoding="utf-8"?>
<!-- One file card of step 1: what was dropped in and what it is. Format choice, quality and the conversion
     states moved to step 2 and step 3 (ADR-020, ADR-021). -->
<UserControl
  x:Class="Kvertis.App.Views.JobCardControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers">

  <Grid
    x:Name="CardRoot"
    AutomationProperties.Name="{x:Bind Item.AutomationName, Mode=OneWay}"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8">

    <Grid Padding="12" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: thumbnail or kind icon, format badge below. -->
      <StackPanel Grid.Column="0" VerticalAlignment="Top" Spacing="6">
        <Grid
          Width="56"
          Height="56"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          CornerRadius="6">
          <Image
            Source="{x:Bind Item.Thumbnail, Mode=OneWay}"
            Stretch="UniformToFill"
            Visibility="{x:Bind helpers:Ui.Show(Item.HasThumbnail), Mode=OneWay}" />
          <FontIcon
            FontSize="24"
            Glyph="{x:Bind Item.KindGlyph, Mode=OneWay}"
            Visibility="{x:Bind helpers:Ui.Hide(Item.HasThumbnail), Mode=OneWay}" />
        </Grid>
        <Border
          Padding="6,1"
          HorizontalAlignment="Center"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4">
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Item.InputFormatLabel, Mode=OneWay}" />
        </Border>
      </StackPanel>

      <!-- Middle: name, facts, warning, state. -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
        <TextBlock
          Style="{StaticResource BodyStrongTextBlockStyle}"
          Text="{x:Bind Item.FileName, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Item.SizeText, Mode=OneWay}" />
          <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Item.DetailsText, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind helpers:Ui.ShowText(Item.WarningText), Mode=OneWay}">
          <FontIcon FontSize="14" Foreground="{ThemeResource KvVideoBrush}" Glyph="&#xE7BA;" />
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Item.WarningText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Rejected: the file cannot be converted at all. -->
        <StackPanel Spacing="2" Visibility="{x:Bind helpers:Ui.Show(Item.IsRejected), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="16" Foreground="{ThemeResource KvErrorBrush}" Glyph="&#xEA39;" />
            <TextBlock
              VerticalAlignment="Center"
              AutomationProperties.LiveSetting="Assertive"
              Style="{StaticResource BodyStrongTextBlockStyle}"
              Text="{x:Bind Item.ErrorTitle, Mode=OneWay}"
              TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind Item.ErrorBody, Mode=OneWay}"
            TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing
          x:Uid="Card_Detecting_Progress"
          Width="16"
          Height="16"
          HorizontalAlignment="Left"
          IsActive="{x:Bind Item.IsDetecting, Mode=OneWay}"
          Visibility="{x:Bind helpers:Ui.Show(Item.IsDetecting), Mode=OneWay}" />
      </StackPanel>

      <!-- Right: remove. -->
      <Button
        x:Uid="Card_Remove_Button"
        Grid.Column="2"
        Width="{StaticResource IconButtonSize}"
        Height="{StaticResource IconButtonSize}"
        VerticalAlignment="Center"
        Padding="0"
        Command="{x:Bind Item.RemoveCommand, Mode=OneWay}"
        Visibility="{x:Bind helpers:Ui.Show(Item.CanRemove), Mode=OneWay}">
        <FontIcon FontSize="14" Glyph="&#xE74D;" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
