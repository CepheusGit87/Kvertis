<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  KeyboardAcceleratorPlacementMode="Hidden"
  NavigationCacheMode="Required">

  <!-- The accelerators belong to the whole page; their floating labels would drift across the galaxy, so
       they are hidden and the shortcuts stand in the drop line and in the tooltips instead. -->
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked" />
    <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <!-- The whole page is the drop target now, not one card (worksheet step 1). -->
  <Grid
    x:Name="PageRoot"
    AllowDrop="True"
    DragLeave="OnPageDragLeave"
    DragOver="OnPageDragOver"
    Drop="OnPageDrop">
    <SplitView
      x:Name="HistorySplitView"
      DisplayMode="Overlay"
      IsPaneOpen="{x:Bind History.IsOpen, Mode=TwoWay}"
      OpenPaneLength="440"
      PaneBackground="{ThemeResource KvBackgroundBrush}"
      PaneClosed="OnHistoryPaneChanged"
      PaneOpened="OnHistoryPaneChanged"
      PanePlacement="Right">
      <SplitView.Pane>
        <views:HistoryPanel ViewModel="{x:Bind History}" />
      </SplitView.Pane>

      <!-- Layout after the draft (#gal-stil): the galaxy runs edge to edge and takes whatever the trays leave;
           the trays are 188 high (52 in the zoom), 16 from the sides and 12 above the action bar. -->
      <Grid SizeChanged="OnContentSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="GalaxyRow" Height="*" MinHeight="240" />
          <RowDefinition x:Name="TrayRow" Height="200" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. The galaxy with sum, drop card, rejected card, zoom hint and, while zoomed, the two format lists. -->
        <Grid Grid.Row="0">
          <views:GalaxyHost x:Name="Galaxy" ZoomRequested="OnGalaxyZoomRequested" />
          <views:PathsOverlay
            x:Name="Paths"
            BackRequested="OnPathsBackRequested"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsZoomed), Mode=OneWay}" />
        </Grid>

        <!-- 2. The five trays, always all of them: images, audio, video, 3D models, documents. -->
        <ScrollViewer
          x:Name="TrayScroll"
          Grid.Row="1"
          Margin="16,0,16,12"
          HorizontalScrollBarVisibility="Disabled"
          HorizontalScrollMode="Disabled"
          VerticalScrollMode="Disabled">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="TrayColumn0" Width="*" />
              <ColumnDefinition x:Name="TrayColumn1" Width="*" />
              <ColumnDefinition x:Name="TrayColumn2" Width="*" />
              <ColumnDefinition x:Name="TrayColumn3" Width="*" />
              <ColumnDefinition x:Name="TrayColumn4" Width="*" />
            </Grid.ColumnDefinitions>
            <views:TrayControl
              x:Name="Tray0"
              Grid.Column="0"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray1"
              Grid.Column="1"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray2"
              Grid.Column="2"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray3"
              Grid.Column="3"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray4"
              Grid.Column="4"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
          </Grid>
        </ScrollViewer>

        <!-- 3. Action bar (.leiste): trust line with the mint lock and the single primary button. -->
        <Border Grid.Row="2" Style="{StaticResource KvBottomBarStyle}">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
              Grid.Column="0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
              <FontIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource KvMintBrush}"
                Glyph="&#xE72E;" />
              <TextBlock
                x:Uid="Main_Trust_Text"
                VerticalAlignment="Center"
                FontSize="12"
                Style="{StaticResource KvSmallTextStyle}" />
              <ProgressRing
                x:Uid="Main_Adding_Progress"
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
            </StackPanel>

            <!-- The main path of the new interface: step 1 hands the files to step 2 (ADR-020). -->
            <Button
              x:Name="GoTargetButton"
              x:Uid="Main_GoTarget_Button"
              Grid.Column="1"
              MinWidth="160"
              Command="{x:Bind ViewModel.GoToTargetCommand}"
              Style="{StaticResource KvPrimaryButtonStyle}" />
          </Grid>
        </Border>
      </Grid>
    </SplitView>
  </Grid>
</Page>
