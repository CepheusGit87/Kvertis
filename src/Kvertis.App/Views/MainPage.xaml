<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  xmlns:vm="using:Kvertis.App.ViewModels"
  NavigationCacheMode="Required">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked" />
    <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <Grid x:Name="PageRoot">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="WideState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowState">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <!-- Below 900 px the buttons move to a second row (minimum window 640 x 480, docs/06). -->
            <Setter Target="ActionButtons.(Grid.Row)" Value="1" />
            <Setter Target="ActionButtons.(Grid.Column)" Value="0" />
            <Setter Target="ActionButtons.(Grid.ColumnSpan)" Value="3" />
            <Setter Target="ActionButtons.HorizontalAlignment" Value="Right" />
            <Setter Target="OverallPanel.(Grid.ColumnSpan)" Value="2" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <SplitView
      x:Name="HistorySplitView"
      DisplayMode="Overlay"
      IsPaneOpen="{x:Bind History.IsOpen, Mode=TwoWay}"
      OpenPaneLength="380"
      PanePlacement="Right">
      <SplitView.Pane>
        <views:HistoryPanel ViewModel="{x:Bind History}" />
      </SplitView.Pane>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,8,24,0" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 1. Drop zone: large while empty, a slim bar once files are there (docs/06, "Hauptansicht"). -->
          <Grid
            x:Name="DropZone"
            Grid.Row="0"
            AllowDrop="True"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            DragLeave="OnDropZoneDragLeave"
            DragOver="OnDropZoneDragOver"
            Drop="OnDropZoneDrop">
            <Rectangle
              RadiusX="8"
              RadiusY="8"
              Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
              StrokeDashArray="4,3"
              StrokeThickness="1.5" />

            <StackPanel
              Padding="24,40"
              HorizontalAlignment="Center"
              Spacing="12"
              Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowEmptyState), Mode=OneWay}">
              <FontIcon FontSize="40" Glyph="&#xE898;" />
              <TextBlock
                x:Uid="Main_DropZone_Title"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Button x:Uid="Main_AddFiles_Button" Command="{x:Bind ViewModel.AddFilesCommand}" />
                <HyperlinkButton x:Uid="Main_AddFolder_Link" Command="{x:Bind ViewModel.AddFolderCommand}" />
              </StackPanel>
              <TextBlock x:Uid="Main_DropZone_PasteHint" HorizontalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" />
            </StackPanel>

            <Grid
              Padding="16,8"
              ColumnSpacing="12"
              Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasJobs), Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE898;" />
              <TextBlock
                x:Uid="Main_DropZone_More"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
              <Button x:Uid="Main_AddMoreFiles_Button" Grid.Column="2" Command="{x:Bind ViewModel.AddFilesCommand}" />
              <HyperlinkButton x:Uid="Main_AddMoreFolder_Link" Grid.Column="3" Command="{x:Bind ViewModel.AddFolderCommand}" />
            </Grid>
          </Grid>

          <!-- 2. Trust line, always visible. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE72E;" />
            <TextBlock x:Uid="Main_Trust_Text" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
              x:Uid="Main_Adding_Progress"
              Width="16"
              Height="16"
              IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
          </StackPanel>

          <!-- 3. Pro hint: a small card, never a modal interruption (docs/06, "Pro-Hinweis"). -->
          <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowProCard), Mode=OneWay}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Glyph="&#xE734;" />
              <TextBlock
                x:Name="ProCardText"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.ProCardText, Mode=OneWay}"
                TextWrapping="Wrap" />
              <Button x:Uid="Main_ProCard_LearnMore" Grid.Column="2" Command="{x:Bind ViewModel.OpenProCommand}" />
              <Button
                x:Uid="Main_ProCard_Dismiss"
                Grid.Column="3"
                Width="{StaticResource IconButtonSize}"
                Height="{StaticResource IconButtonSize}"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.DismissProCardCommand}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
              </Button>
            </Grid>
          </Border>

          <!-- 4. Job list: one card per file. -->
          <ListView
            x:Name="JobList"
            x:Uid="Main_JobList"
            Grid.Row="3"
            Padding="0,0,0,12"
            ContainerContentChanging="OnJobListContainerContentChanging"
            ItemsSource="{x:Bind ViewModel.Jobs}"
            PreviewKeyDown="OnJobListPreviewKeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:JobItemViewModel">
                <views:JobCardControl Item="{x:Bind}" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- Screen reader live region for finished and failed jobs. -->
          <TextBlock
            x:Name="AnnouncementText"
            Grid.Row="3"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.LiveSetting="Assertive"
            IsHitTestVisible="False"
            Opacity="0"
            Text="{x:Bind ViewModel.Announcement, Mode=OneWay}" />
        </Grid>

        <!-- 5. Action bar, fixed at the bottom. -->
        <Border
          Grid.Row="1"
          Padding="24,12"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
              <ComboBox
                x:Uid="Main_Output_ComboBox"
                MinWidth="200"
                SelectedIndex="{x:Bind ViewModel.OutputLocationIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="Main_Output_Same" />
                <ComboBoxItem x:Uid="Main_Output_Sub" />
                <ComboBoxItem x:Uid="Main_Output_Custom" />
              </ComboBox>
              <Button
                x:Uid="Main_Output_Change"
                Width="{StaticResource IconButtonSize}"
                Height="{StaticResource IconButtonSize}"
                Padding="0"
                Command="{x:Bind ViewModel.ChangeOutputFolderCommand}">
                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
              </Button>
              <TextBlock
                MaxWidth="220"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.CustomFolderPath, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowCustomFolderPath), Mode=OneWay}" />
            </StackPanel>

            <StackPanel x:Name="OverallPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock
                x:Name="OverallText"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.OverallText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
              <ProgressBar
                x:Uid="Main_Overall_Progress"
                AutomationProperties.HelpText="{x:Bind ViewModel.OverallAutomationText, Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite"
                Maximum="100"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsQueueActive), Mode=OneWay}"
                Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
              x:Name="ActionButtons"
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
              <Button
                x:Uid="Main_ClearFinished_Button"
                Command="{x:Bind ViewModel.ClearFinishedCommand}"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasFinishedJobs), Mode=OneWay}" />
              <Button
                x:Name="PauseAllButton"
                AutomationProperties.Name="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.PauseAllCommand}"
                Content="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsQueueActive), Mode=OneWay}" />
              <Button
                x:Uid="Main_CancelAll_Button"
                Command="{x:Bind ViewModel.CancelAllCommand}"
                Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsQueueActive), Mode=OneWay}" />
              <Button
                x:Name="StartButton"
                x:Uid="Main_Start_Button"
                MinWidth="120"
                MinHeight="40"
                Command="{x:Bind ViewModel.StartCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </SplitView>
  </Grid>
</Page>
