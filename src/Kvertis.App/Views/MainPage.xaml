<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  xmlns:vm="using:Kvertis.App.ViewModels"
  NavigationCacheMode="Required">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked" />
    <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <Grid x:Name="PageRoot">
    <SplitView
      x:Name="HistorySplitView"
      DisplayMode="Overlay"
      IsPaneOpen="{x:Bind History.IsOpen, Mode=TwoWay}"
      OpenPaneLength="380"
      PanePlacement="Right">
      <SplitView.Pane>
        <views:HistoryPanel ViewModel="{x:Bind History}" />
      </SplitView.Pane>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,8,24,0" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 1. Drop zone: large while empty, a slim bar once files are there (docs/06, "Hauptansicht"). -->
          <Grid
            x:Name="DropZone"
            Grid.Row="0"
            AllowDrop="True"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            DragLeave="OnDropZoneDragLeave"
            DragOver="OnDropZoneDragOver"
            Drop="OnDropZoneDrop">
            <Rectangle
              RadiusX="8"
              RadiusY="8"
              Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
              StrokeDashArray="4,3"
              StrokeThickness="1.5" />

            <StackPanel
              Padding="24,40"
              HorizontalAlignment="Center"
              Spacing="12"
              Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowEmptyState), Mode=OneWay}">
              <FontIcon FontSize="40" Glyph="&#xE898;" />
              <TextBlock
                x:Uid="Main_DropZone_Title"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Button x:Uid="Main_AddFiles_Button" Command="{x:Bind ViewModel.AddFilesCommand}" />
                <HyperlinkButton x:Uid="Main_AddFolder_Link" Command="{x:Bind ViewModel.AddFolderCommand}" />
              </StackPanel>
              <TextBlock x:Uid="Main_DropZone_PasteHint" HorizontalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" />
            </StackPanel>

            <Grid
              Padding="16,8"
              ColumnSpacing="12"
              Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasJobs), Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE898;" />
              <TextBlock
                x:Uid="Main_DropZone_More"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
              <Button x:Uid="Main_AddMoreFiles_Button" Grid.Column="2" Command="{x:Bind ViewModel.AddFilesCommand}" />
              <HyperlinkButton x:Uid="Main_AddMoreFolder_Link" Grid.Column="3" Command="{x:Bind ViewModel.AddFolderCommand}" />
            </Grid>
          </Grid>

          <!-- 2. Trust line, always visible. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE72E;" />
            <TextBlock x:Uid="Main_Trust_Text" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
              x:Uid="Main_Adding_Progress"
              Width="16"
              Height="16"
              IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
          </StackPanel>

          <!-- 3. Job list: one card per file. -->
          <ListView
            x:Name="JobList"
            x:Uid="Main_JobList"
            Grid.Row="2"
            Padding="0,0,0,12"
            ContainerContentChanging="OnJobListContainerContentChanging"
            ItemsSource="{x:Bind ViewModel.Jobs}"
            PreviewKeyDown="OnJobListPreviewKeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:JobItemViewModel">
                <views:JobCardControl Item="{x:Bind}" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <!-- 4. Action bar, fixed at the bottom. -->
        <Border
          Grid.Row="1"
          Padding="24,12"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The main path of the new interface: step 1 hands the files to step 2 (ADR-020).
                 Start, output location and progress belong to step 3 now (ADR-021). -->
            <Button
              x:Name="GoTargetButton"
              x:Uid="Main_GoTarget_Button"
              Grid.Column="1"
              MinWidth="160"
              MinHeight="40"
              Command="{x:Bind ViewModel.GoToTargetCommand}"
              Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </Border>
      </Grid>
    </SplitView>
  </Grid>
</Page>
