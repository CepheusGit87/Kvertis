<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  KeyboardAcceleratorPlacementMode="Hidden"
  NavigationCacheMode="Required">

  <!-- The accelerators belong to the whole page; their floating labels would drift across the galaxy, so
       they are hidden and the shortcuts stand in the drop line and in the tooltips instead. -->
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked" />
    <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAcceleratorInvoked" />
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <!-- The whole page is the drop target now, not one card (worksheet step 1). -->
  <Grid
    x:Name="PageRoot"
    AllowDrop="True"
    DragLeave="OnPageDragLeave"
    DragOver="OnPageDragOver"
    Drop="OnPageDrop">
    <SplitView
      x:Name="HistorySplitView"
      DisplayMode="Overlay"
      IsPaneOpen="{x:Bind History.IsOpen, Mode=TwoWay}"
      OpenPaneLength="380"
      PaneClosed="OnHistoryPaneChanged"
      PaneOpened="OnHistoryPaneChanged"
      PanePlacement="Right">
      <SplitView.Pane>
        <views:HistoryPanel ViewModel="{x:Bind History}" />
      </SplitView.Pane>

      <Grid Padding="24,8,24,0" RowSpacing="12" SizeChanged="OnContentSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="GalaxyRow" Height="2*" MinHeight="240" MaxHeight="520" />
          <RowDefinition x:Name="TrayRow" Height="3*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- 1. The galaxy with the drop line, the rejected card and, while zoomed, the two format lists. -->
        <Grid Grid.Row="0">
          <views:GalaxyHost x:Name="Galaxy" ZoomRequested="OnGalaxyZoomRequested" />
          <views:PathsOverlay
            x:Name="Paths"
            BackRequested="OnPathsBackRequested"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsZoomed), Mode=OneWay}" />
        </Grid>

        <!-- 2. The five trays, always all of them: images, audio, video, 3D models, documents. -->
        <ScrollViewer
          x:Name="TrayScroll"
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          HorizontalScrollMode="Disabled"
          VerticalScrollMode="Disabled">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="TrayColumn0" Width="*" />
              <ColumnDefinition x:Name="TrayColumn1" Width="*" />
              <ColumnDefinition x:Name="TrayColumn2" Width="*" />
              <ColumnDefinition x:Name="TrayColumn3" Width="*" />
              <ColumnDefinition x:Name="TrayColumn4" Width="*" />
            </Grid.ColumnDefinitions>
            <views:TrayControl
              x:Name="Tray0"
              Grid.Column="0"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray1"
              Grid.Column="1"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray2"
              Grid.Column="2"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray3"
              Grid.Column="3"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
            <views:TrayControl
              x:Name="Tray4"
              Grid.Column="4"
              AcceptRequested="OnTrayAccepted"
              HeadInvoked="OnTrayHeadInvoked" />
          </Grid>
        </ScrollViewer>

        <!-- 3. Action bar: trust line and the single mint button. -->
        <Border
          Grid.Row="2"
          Margin="-24,0"
          Padding="24,12"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
              Grid.Column="0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
              <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE72E;" />
              <TextBlock x:Uid="Main_Trust_Text" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
              <ProgressRing
                x:Uid="Main_Adding_Progress"
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
            </StackPanel>

            <!-- The main path of the new interface: step 1 hands the files to step 2 (ADR-020). -->
            <Button
              x:Name="GoTargetButton"
              x:Uid="Main_GoTarget_Button"
              Grid.Column="1"
              MinWidth="160"
              MinHeight="40"
              Command="{x:Bind ViewModel.GoToTargetCommand}"
              Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </Border>
      </Grid>
    </SplitView>
  </Grid>
</Page>
