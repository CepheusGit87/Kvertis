<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.ProPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers">

  <ScrollViewer>
    <StackPanel MaxWidth="720" Padding="24,8,24,24" Spacing="16">
      <TextBlock x:Uid="Pro_Title" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Uid="Pro_Intro" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

      <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE714;" />
            <TextBlock x:Uid="Pro_Feature_Video" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE8B3;" />
            <TextBlock x:Uid="Pro_Feature_Batch" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE8FB;" />
            <TextBlock x:Uid="Pro_Feature_Once" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE72E;" />
            <TextBlock x:Uid="Pro_Feature_NoAds" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsPro), Mode=OneWay}" />
        <TextBlock
          AutomationProperties.LiveSetting="Polite"
          Style="{StaticResource BodyStrongTextBlockStyle}"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button
          x:Uid="Pro_Buy_Button"
          Command="{x:Bind ViewModel.PurchaseCommand}"
          Style="{StaticResource AccentButtonStyle}"
          Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsFree), Mode=OneWay}" />
        <Button x:Uid="Pro_Restore_Button" Command="{x:Bind ViewModel.RestoreCommand}" />
        <ProgressRing x:Uid="Pro_Busy_Progress" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>

      <TextBlock
        AutomationProperties.LiveSetting="Assertive"
        Style="{StaticResource BodyTextBlockStyle}"
        Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
        TextWrapping="Wrap" />
      <TextBlock x:Uid="Pro_Store_Note" Style="{StaticResource SecondaryCaptionTextStyle}" />
    </StackPanel>
  </ScrollViewer>
</Page>
