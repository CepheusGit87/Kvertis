<?xml version="1.0" encoding="utf-8"?>
<!--
  Kvertis Pro (look after docs/entwuerfe/abgleich-mischentwurf.md 3.8): gradient card like .rk, feature rows 13 with a
  16 px mint symbol, .pro badge next to the status, .taste for buying and .btn for restoring.
-->
<Page
  x:Class="Kvertis.App.Views.ProPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers">

  <Page.Resources>
    <Style x:Key="ProFeatureIconStyle" TargetType="FontIcon">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="Foreground" Value="{ThemeResource KvMintBrush}" />
    </Style>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel MaxWidth="720" Padding="22,14,22,24" Spacing="16">
      <TextBlock x:Uid="Pro_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource KvTitleTextStyle}" />
      <TextBlock x:Uid="Pro_Intro" Style="{StaticResource KvBodyTextStyle}" />

      <!-- .rk: gradient card with the inner top edge (karton-kante) -->
      <Border Padding="0" Style="{StaticResource KvCardStyle}">
        <Border
          Padding="14,12"
          BorderBrush="{ThemeResource KvEdgeBrush}"
          BorderThickness="0,1,0,0"
          CornerRadius="12">
          <StackPanel Spacing="10">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE714;" Style="{StaticResource ProFeatureIconStyle}" />
              <TextBlock x:Uid="Pro_Feature_Video" Grid.Column="1" Style="{StaticResource KvBodyTextStyle}" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8B3;" Style="{StaticResource ProFeatureIconStyle}" />
              <TextBlock x:Uid="Pro_Feature_Batch" Grid.Column="1" Style="{StaticResource KvBodyTextStyle}" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8FB;" Style="{StaticResource ProFeatureIconStyle}" />
              <TextBlock x:Uid="Pro_Feature_Once" Grid.Column="1" Style="{StaticResource KvBodyTextStyle}" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE72E;" Style="{StaticResource ProFeatureIconStyle}" />
              <TextBlock x:Uid="Pro_Feature_NoAds" Grid.Column="1" Style="{StaticResource KvBodyTextStyle}" />
            </Grid>
          </StackPanel>
        </Border>
      </Border>

      <!-- Status: .pro badge and the status text 13 / SemiBold -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Style="{StaticResource KvProBadgeStyle}">
          <TextBlock x:Uid="Pro_Badge" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource KvProBadgeTextStyle}" />
        </Border>
        <TextBlock
          VerticalAlignment="Center"
          AutomationProperties.LiveSetting="Polite"
          FontWeight="SemiBold"
          Style="{StaticResource KvBodyTextStyle}"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <FontIcon
          VerticalAlignment="Center"
          AutomationProperties.AccessibilityView="Raw"
          FontSize="14"
          Foreground="{ThemeResource KvMintBrush}"
          Glyph="&#xE73E;"
          Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsPro), Mode=OneWay}" />
      </StackPanel>

      <!-- Bottom padding leaves room for the 4 px socket of the primary button. -->
      <StackPanel Padding="0,0,0,4" Orientation="Horizontal" Spacing="12">
        <Button
          x:Uid="Pro_Buy_Button"
          Command="{x:Bind ViewModel.PurchaseCommand}"
          Style="{StaticResource KvPrimaryButtonStyle}"
          Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsFree), Mode=OneWay}" />
        <Button x:Uid="Pro_Restore_Button" Command="{x:Bind ViewModel.RestoreCommand}" />
        <ProgressRing
          x:Uid="Pro_Busy_Progress"
          Width="20"
          Height="20"
          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>

      <TextBlock
        AutomationProperties.LiveSetting="Assertive"
        Style="{StaticResource KvBodyTextStyle}"
        Text="{x:Bind ViewModel.MessageText, Mode=OneWay}" />
      <TextBlock x:Uid="Pro_Store_Note" Style="{StaticResource KvSmallTextStyle}" TextTrimming="None" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
