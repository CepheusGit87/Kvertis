<Page
  x:Class="Kvertis.App.Views.ConvertPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  NavigationCacheMode="Required">

  <ScrollViewer>
    <StackPanel MaxWidth="720" Padding="24" Spacing="12">
      <TextBlock x:Uid="Convert_Title" Style="{StaticResource TitleTextBlockStyle}" />
      <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock
            x:Name="PlanText"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
          <TextBlock x:Uid="Convert_Placeholder_Text" Style="{StaticResource SecondaryCaptionTextStyle}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
