<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3 "Umwandeln" (docs/entwuerfe/schritt-3-umwandeln.md). Pure XAML: left the inbox, in the middle
     SwirlHost with the running files, right the result and the output location, below the list and the bar.
     SwirlHost is the empty surface the drawing layer (pixel swirl, white hole) is hung into later (ADR-018);
     the cards inside it stay above it. Colours only from Themes/KvertisColors.xaml. -->
<Page
  x:Class="Kvertis.App.Views.ConvertPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:convert="using:Kvertis.App.ViewModels.Convert"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:views="using:Kvertis.App.Views"
  NavigationCacheMode="Required">

  <Page.Resources>

    <!-- Left: one waiting (or failed) file -->
    <DataTemplate x:Key="InboxRowTemplate" x:DataType="convert:ConvertRowViewModel">
      <Grid
        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
        ColumnSpacing="8"
        Padding="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse
          Width="10"
          Height="10"
          VerticalAlignment="Center"
          Fill="{x:Bind helpers:Ui.Brush(ColorBrushKey)}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Style="{StaticResource BodyTextBlockStyle}"
          Text="{x:Bind FileName}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          Text="{x:Bind StateText, Mode=OneWay}" />
      </Grid>
    </DataTemplate>

    <!-- Right: a finished file -->
    <DataTemplate x:Key="DoneRowTemplate" x:DataType="convert:ConvertRowViewModel">
      <Grid
        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
        ColumnSpacing="8"
        Padding="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          FontSize="12"
          Foreground="{ThemeResource KvMintBrush}"
          Glyph="&#xE73E;" />
        <TextBlock
          Grid.Column="1"
          Style="{StaticResource BodyTextBlockStyle}"
          Text="{x:Bind TargetFileName, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <!-- The list at the bottom: one line per file of the plan -->
    <DataTemplate x:Key="ListRowTemplate" x:DataType="convert:ConvertRowViewModel">
      <Grid
        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
        BorderBrush="{ThemeResource KvLineBrush}"
        BorderThickness="0,0,0,1"
        ColumnSpacing="12"
        Padding="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse
          Width="10"
          Height="10"
          VerticalAlignment="Center"
          Fill="{x:Bind helpers:Ui.Brush(ColorBrushKey)}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind FileName}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SizesText, Mode=OneWay}" />
        </StackPanel>

        <Border
          Grid.Column="2"
          Padding="6,1"
          VerticalAlignment="Center"
          BorderBrush="{ThemeResource KvLineStrongBrush}"
          BorderThickness="1"
          CornerRadius="4">
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind FormatsText}" />
        </Border>

        <StackPanel
          Grid.Column="3"
          VerticalAlignment="Center"
          ToolTipService.ToolTip="{x:Bind FullPath, Mode=OneWay}">
          <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind TargetDirectoryText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock
              Style="{StaticResource BodyStrongTextBlockStyle}"
              Text="{x:Bind TargetFileName, Mode=OneWay}"
              TextTrimming="CharacterEllipsis"
              Visibility="{x:Bind helpers:Ui.Show(ShowPath), Mode=OneWay}" />
            <TextBlock
              Style="{StaticResource SecondaryCaptionTextStyle}"
              Text="{x:Bind TargetMarkText, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>

        <StackPanel
          Grid.Column="4"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="4">
          <DropDownButton
            x:Uid="Convert_Row_Change_Button"
            Visibility="{x:Bind helpers:Ui.Show(CanChangeTarget), Mode=OneWay}">
            <DropDownButton.Flyout>
              <Flyout Placement="Top">
                <StackPanel MinWidth="220" Spacing="6">
                  <TextBlock x:Uid="Convert_Row_Location_Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <RadioButton
                    x:Uid="Convert_Row_Location_Shared"
                    Command="{x:Bind UseSharedCommand}"
                    GroupName="RowTarget"
                    IsChecked="{x:Bind UsesShared, Mode=OneWay}" />
                  <RadioButton
                    x:Uid="Convert_Location_Same_Option"
                    Command="{x:Bind UseSameFolderCommand}"
                    GroupName="RowTarget"
                    IsChecked="{x:Bind IsSame, Mode=OneWay}" />
                  <RadioButton
                    x:Uid="Convert_Location_Sub_Option"
                    Command="{x:Bind UseSubFolderCommand}"
                    GroupName="RowTarget"
                    IsChecked="{x:Bind IsSub, Mode=OneWay}" />
                  <RadioButton
                    x:Uid="Convert_Location_Custom_Option"
                    Command="{x:Bind UseCustomFolderCommand}"
                    GroupName="RowTarget"
                    IsChecked="{x:Bind IsCustom, Mode=OneWay}" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button
            x:Uid="Convert_Row_Open_Button"
            Command="{x:Bind OpenCommand}"
            Visibility="{x:Bind helpers:Ui.Show(IsDone), Mode=OneWay}" />
          <Button
            x:Uid="Convert_Row_ShowInFolder_Button"
            Command="{x:Bind ShowInFolderCommand}"
            Visibility="{x:Bind helpers:Ui.Show(IsDone), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="5" VerticalAlignment="Center" MinWidth="110">
          <TextBlock
            HorizontalAlignment="Right"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind StateText, Mode=OneWay}" />
          <TextBlock
            HorizontalAlignment="Right"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind PercentText, Mode=OneWay}"
            Visibility="{x:Bind helpers:Ui.Show(ShowProgress), Mode=OneWay}" />
          <StackPanel Visibility="{x:Bind helpers:Ui.Show(HasError), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon
                FontSize="14"
                Foreground="{ThemeResource KvErrorBrush}"
                Glyph="&#xEA39;" />
              <TextBlock
                AutomationProperties.LiveSetting="Assertive"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ErrorTitle, Mode=OneWay}"
                TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
              Style="{StaticResource SecondaryCaptionTextStyle}"
              Text="{x:Bind ErrorBody, Mode=OneWay}"
              TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TextLineTemplate" x:DataType="x:String">
      <TextBlock
        Padding="0,2"
        Style="{StaticResource SecondaryCaptionTextStyle}"
        Text="{x:Bind}"
        TextWrapping="Wrap" />
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="WideLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <!-- Below 900 px the three columns stack above the list; 640 px stays usable (docs/06). -->
            <Setter Target="LeftColumn.Width" Value="*" />
            <Setter Target="MiddleColumn.Width" Value="0" />
            <Setter Target="RightColumn.Width" Value="0" />
            <Setter Target="MiddlePanel.(Grid.Column)" Value="0" />
            <Setter Target="MiddlePanel.(Grid.Row)" Value="1" />
            <Setter Target="RightPanel.(Grid.Column)" Value="0" />
            <Setter Target="RightPanel.(Grid.Row)" Value="2" />
            <Setter Target="ListPanel.(Grid.Row)" Value="3" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid
        x:Name="PageRoot"
        Padding="24"
        ColumnSpacing="20"
        RowSpacing="20"
        SizeChanged="OnBagSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftColumn" Width="300" />
          <ColumnDefinition x:Name="MiddleColumn" Width="*" />
          <ColumnDefinition x:Name="RightColumn" Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: the inbox -->
        <StackPanel x:Name="LeftPanel" Spacing="8">
          <TextBlock x:Uid="Convert_Title" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock
            x:Uid="Convert_NoPlan_Text"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowNoPlan), Mode=OneWay}" />
          <TextBlock
            AutomationProperties.LiveSetting="Assertive"
            Foreground="{ThemeResource KvErrorBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:Ui.ShowText(ViewModel.ErrorText), Mode=OneWay}" />
          <TextBlock x:Uid="Convert_Inbox_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind ViewModel.InboxSummaryText, Mode=OneWay}" />
          <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock
                Foreground="{ThemeResource KvErrorBrush}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.InboxFailedText, Mode=OneWay}"
                Visibility="{x:Bind helpers:Ui.ShowText(ViewModel.InboxFailedText), Mode=OneWay}" />
              <ItemsControl
                ItemTemplate="{StaticResource InboxRowTemplate}"
                ItemsSource="{x:Bind ViewModel.Inbox}" />
            </StackPanel>
          </Border>

          <!-- Files step 2 had to leave out, with the reason -->
          <StackPanel Spacing="4" Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasSkipped), Mode=OneWay}">
            <TextBlock x:Uid="Convert_Skipped_Header" Style="{StaticResource SectionHeaderTextStyle}" />
            <ItemsControl ItemTemplate="{StaticResource TextLineTemplate}" ItemsSource="{x:Bind ViewModel.SkippedTexts}" />
          </StackPanel>

          <!-- Pro card: only with a reason, never a modal (docs/06, "Pro-Hinweis") -->
          <Border
            Background="{ThemeResource KvMintSurfaceBrush}"
            BorderBrush="{ThemeResource KvMintFrameBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowProCard), Mode=OneWay}">
            <StackPanel Spacing="8">
              <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.ProCardText, Mode=OneWay}"
                TextWrapping="Wrap" />
              <Button x:Uid="Convert_Pro_LearnMore_Button" Command="{x:Bind ViewModel.OpenProCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Middle: the swirl surface (ADR-023) with the running files and the report as XAML above it -->
        <StackPanel x:Name="MiddlePanel" Grid.Column="1" Spacing="8">
          <TextBlock x:Uid="Convert_Swirl_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <views:SwirlHost x:Name="SwirlHost" ShakeRequested="OnSwirlShakeRequested" />
        </StackPanel>

        <!-- Right: what is finished, then the output location -->
        <StackPanel x:Name="RightPanel" Grid.Column="2" Spacing="8">
          <TextBlock x:Uid="Convert_Result_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <TextBlock
            x:Name="DoneText"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.DoneText, Mode=OneWay}" />
          <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <ItemsControl ItemTemplate="{StaticResource DoneRowTemplate}" ItemsSource="{x:Bind ViewModel.Done}" />
          </Border>

          <Border
            x:Name="LocationCard"
            AllowDrop="True"
            AutomationProperties.Name="{x:Bind ViewModel.Location.AutomationName, Mode=OneWay}"
            DragOver="OnLocationDragOver"
            Drop="OnLocationDrop"
            Style="{StaticResource CardBorderStyle}"
            Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Uid="Convert_Location_Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Location.TitleText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.Location.DetailText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.Location.DetailText, Mode=OneWay}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <DropDownButton x:Uid="Convert_Location_Change_Button" IsEnabled="{x:Bind ViewModel.Location.IsEnabled, Mode=OneWay}">
                  <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                      <StackPanel MinWidth="240" Spacing="6">
                        <RadioButton
                          x:Uid="Convert_Location_Same_Option"
                          Command="{x:Bind ViewModel.Location.UseSameFolderCommand}"
                          GroupName="SharedTarget"
                          IsChecked="{x:Bind ViewModel.Location.IsSame, Mode=OneWay}" />
                        <RadioButton
                          x:Uid="Convert_Location_Sub_Option"
                          Command="{x:Bind ViewModel.Location.UseSubFolderCommand}"
                          GroupName="SharedTarget"
                          IsChecked="{x:Bind ViewModel.Location.IsSub, Mode=OneWay}" />
                        <RadioButton
                          x:Uid="Convert_Location_Custom_Option"
                          Command="{x:Bind ViewModel.Location.UseCustomFolderCommand}"
                          GroupName="SharedTarget"
                          IsChecked="{x:Bind ViewModel.Location.IsCustom, Mode=OneWay}" />
                        <Button
                          x:Uid="Convert_Location_Pick_Button"
                          Command="{x:Bind ViewModel.Location.UseCustomFolderCommand}" />
                      </StackPanel>
                    </Flyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton
                  x:Name="BagButton"
                  AutomationProperties.Name="{x:Bind ViewModel.BagText, Mode=OneWay}"
                  Content="{x:Bind ViewModel.BagText, Mode=OneWay}"
                  SizeChanged="OnBagSizeChanged"
                  Visibility="{x:Bind helpers:Ui.Show(ViewModel.HasBagEntries), Mode=OneWay}">
                  <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                      <StackPanel MinWidth="260" Spacing="6">
                        <TextBlock x:Uid="Convert_Bag_Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemTemplate="{StaticResource TextLineTemplate}" ItemsSource="{x:Bind ViewModel.BagEntries}" />
                      </StackPanel>
                    </Flyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The list of all files of this round -->
        <StackPanel
          x:Name="ListPanel"
          Grid.Row="1"
          Grid.ColumnSpan="3"
          Spacing="8">
          <TextBlock x:Uid="Convert_List_Header" Style="{StaticResource SectionHeaderTextStyle}" />
          <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind ViewModel.ListSummaryText, Mode=OneWay}" />
          <Border Style="{StaticResource CardBorderStyle}" Padding="16,0">
            <ItemsControl
              x:Name="RowsList"
              ItemTemplate="{StaticResource ListRowTemplate}"
              ItemsSource="{x:Bind ViewModel.Rows}" />
          </Border>
        </StackPanel>

        <!-- Screen reader live region for a finished or failed file and for the report. -->
        <TextBlock
          x:Name="AnnouncementText"
          Grid.Row="1"
          Width="1"
          Height="1"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          AutomationProperties.LiveSetting="Assertive"
          IsHitTestVisible="False"
          Opacity="0"
          Text="{x:Bind ViewModel.Announcement, Mode=OneWay}" />
      </Grid>
    </ScrollViewer>

    <!-- Bottom bar: trust line, overall progress, the actions of the round -->
    <Border
      Grid.Row="1"
      Background="{ThemeResource KvPanelBrush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="0,1,0,0"
      Padding="24,12">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="14" Glyph="&#xE72E;" />
          <TextBlock x:Uid="Convert_Trust_Text" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock
            x:Name="OverallText"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.OverallText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
          <ProgressBar
            AutomationProperties.Name="{x:Bind ViewModel.OverallAutomationText, Mode=OneWay}"
            IsIndeterminate="False"
            Maximum="100"
            Minimum="0"
            Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
          <Button
            x:Uid="Convert_Back_Button"
            Command="{x:Bind ViewModel.BackCommand}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsReady), Mode=OneWay}" />
          <Button
            AutomationProperties.Name="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
            Command="{x:Bind ViewModel.PauseOrResumeCommand}"
            Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsRunningOrPaused), Mode=OneWay}" />
          <Button
            x:Uid="Convert_CancelAll_Button"
            Command="{x:Bind ViewModel.CancelAllCommand}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsRunningOrPaused), Mode=OneWay}" />
          <Button
            x:Name="StartButton"
            MinWidth="180"
            MinHeight="40"
            AutomationProperties.Name="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
            Command="{x:Bind ViewModel.StartCommand}"
            Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsReady), Mode=OneWay}" />
          <Button
            x:Uid="Convert_NewRound_Button"
            MinWidth="160"
            MinHeight="40"
            Command="{x:Bind ViewModel.NewRoundCommand}"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsFinished), Mode=OneWay}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
