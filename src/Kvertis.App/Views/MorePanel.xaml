<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Kvertis.App.Views.MorePanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- "More" panel (docs/06-design.md, section 3): for experienced users, closed by default. -->
  <StackPanel Width="320" Spacing="12">
    <TextBlock x:Uid="More_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />

    <StackPanel Spacing="2">
      <Slider
        x:Uid="More_Quality_Slider"
        Maximum="100"
        Minimum="0"
        StepFrequency="1"
        TickFrequency="10"
        Value="{x:Bind Item.Quality, Mode=TwoWay}" />
      <Grid>
        <TextBlock x:Uid="More_Quality_Smaller" HorizontalAlignment="Left" Style="{StaticResource SecondaryCaptionTextStyle}" />
        <TextBlock x:Uid="More_Quality_Better" HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionTextStyle}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Uid="More_Estimate_Label" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock
          AutomationProperties.LiveSetting="Polite"
          Style="{StaticResource CaptionTextBlockStyle}"
          Text="{x:Bind Item.EstimateSizeText, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <NumberBox
        x:Uid="More_TargetSize_NumberBox"
        Grid.Column="0"
        Minimum="0"
        SpinButtonPlacementMode="Hidden"
        Value="{x:Bind Item.TargetSize, Mode=TwoWay}" />
      <ComboBox
        x:Uid="More_TargetSizeUnit_ComboBox"
        Grid.Column="1"
        VerticalAlignment="Bottom"
        SelectedIndex="{x:Bind Item.TargetSizeUnitIndex, Mode=TwoWay}">
        <ComboBoxItem x:Uid="More_Unit_KB" />
        <ComboBoxItem x:Uid="More_Unit_MB" />
      </ComboBox>
    </Grid>
    <TextBlock x:Uid="More_TargetSize_Hint" Style="{StaticResource SecondaryCaptionTextStyle}" />

    <ToggleSwitch x:Uid="More_Metadata_Toggle" IsOn="{x:Bind Item.StripMetadata, Mode=TwoWay}" />
    <TextBlock x:Uid="More_Metadata_Hint" Style="{StaticResource SecondaryCaptionTextStyle}" />

    <TextBox x:Uid="More_NamePattern_TextBox" Text="{x:Bind Item.NamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock x:Uid="More_NamePreview_Label" Style="{StaticResource SecondaryCaptionTextStyle}" />
      <TextBlock
        Style="{StaticResource CaptionTextBlockStyle}"
        Text="{x:Bind Item.NamePreview, Mode=OneWay}"
        TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Button x:Uid="More_ApplyToAll_Button" HorizontalAlignment="Stretch" Command="{x:Bind Item.ApplyToAllCommand, Mode=OneWay}" />
  </StackPanel>
</UserControl>
