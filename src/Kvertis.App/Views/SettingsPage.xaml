<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Kvertis.App.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:helpers="using:Kvertis.App.Helpers">

  <ScrollViewer>
    <StackPanel MaxWidth="900" Padding="24,8,24,24" Spacing="4">
      <TextBlock x:Uid="Settings_Title" Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" />

      <InfoBar
        x:Uid="Settings_Restart_InfoBar"
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
        Severity="Informational" />

      <!-- Appearance -->
      <TextBlock x:Uid="Settings_Appearance_Header" Style="{StaticResource SectionHeaderTextStyle}" />
      <controls:SettingsCard x:Uid="Settings_Language_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xF2B7;" />
        </controls:SettingsCard.HeaderIcon>
        <ComboBox x:Uid="Settings_Language_ComboBox" MinWidth="180" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
          <ComboBoxItem x:Uid="Settings_Language_System" />
          <ComboBoxItem x:Uid="Settings_Language_German" />
          <ComboBoxItem x:Uid="Settings_Language_English" />
        </ComboBox>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Theme_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE790;" />
        </controls:SettingsCard.HeaderIcon>
        <ComboBox x:Uid="Settings_Theme_ComboBox" MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
          <ComboBoxItem x:Uid="Settings_Theme_System" />
          <ComboBoxItem x:Uid="Settings_Theme_Light" />
          <ComboBoxItem x:Uid="Settings_Theme_Dark" />
        </ComboBox>
      </controls:SettingsCard>

      <!-- Conversion -->
      <TextBlock x:Uid="Settings_Conversion_Header" Style="{StaticResource SectionHeaderTextStyle}" />
      <controls:SettingsCard x:Uid="Settings_Parallel_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE9D9;" />
        </controls:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Uid="Settings_ParallelAuto_Toggle" IsOn="{x:Bind ViewModel.IsAutoParallel, Mode=TwoWay}" />
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_ParallelCount_Card" Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsManualParallel), Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Slider
            x:Uid="Settings_ParallelCount_Slider"
            Width="200"
            Maximum="16"
            Minimum="1"
            StepFrequency="1"
            Value="{x:Bind ViewModel.MaxParallel, Mode=TwoWay}" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.MaxParallelText, Mode=OneWay}" />
        </StackPanel>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Output_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8B7;" />
        </controls:SettingsCard.HeaderIcon>
        <ComboBox x:Uid="Settings_Output_ComboBox" MinWidth="220" SelectedIndex="{x:Bind ViewModel.OutputLocationIndex, Mode=TwoWay}">
          <ComboBoxItem x:Uid="Main_Output_Same" />
          <ComboBoxItem x:Uid="Main_Output_Sub" />
          <ComboBoxItem x:Uid="Main_Output_Custom" />
        </ComboBox>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_NamePattern_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8AC;" />
        </controls:SettingsCard.HeaderIcon>
        <StackPanel Spacing="4">
          <TextBox x:Uid="Settings_NamePattern_TextBox" MinWidth="220" Text="{x:Bind ViewModel.NamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.NamePreview, Mode=OneWay}" />
        </StackPanel>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Metadata_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE72E;" />
        </controls:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Uid="Settings_Metadata_Toggle" IsOn="{x:Bind ViewModel.StripMetadata, Mode=TwoWay}" />
      </controls:SettingsCard>

      <!-- FFmpeg replacement (LGPL right, docs/02 §2) -->
      <TextBlock x:Uid="Settings_Advanced_Header" Style="{StaticResource SectionHeaderTextStyle}" />
      <controls:SettingsCard x:Uid="Settings_Ffmpeg_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE943;" />
        </controls:SettingsCard.HeaderIcon>
        <StackPanel HorizontalAlignment="Right" Spacing="6">
          <TextBlock
            HorizontalAlignment="Right"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.FfmpegDirectory, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.FfmpegStatusText, Mode=OneWay}" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Settings_Ffmpeg_Choose" Command="{x:Bind ViewModel.PickFfmpegFolderCommand}" />
            <Button x:Uid="Settings_Ffmpeg_Reset" Command="{x:Bind ViewModel.ResetFfmpegFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Logging_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE9F9;" />
        </controls:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Uid="Settings_Logging_Toggle" IsOn="{x:Bind ViewModel.LoggingEnabled, Mode=TwoWay}" />
      </controls:SettingsCard>

      <!-- Pro and about -->
      <TextBlock x:Uid="Settings_About_Header" Style="{StaticResource SectionHeaderTextStyle}" />
      <controls:SettingsCard x:Uid="Settings_Pro_Card" Click="OnProClick" IsClickEnabled="True">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE734;" />
        </controls:SettingsCard.HeaderIcon>
        <TextBlock Text="{x:Bind Pro.StatusText, Mode=OneWay}" />
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_AboutLink_Card" Click="OnAboutClick" IsClickEnabled="True">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE946;" />
        </controls:SettingsCard.HeaderIcon>
        <TextBlock Text="{x:Bind ViewModel.VersionText}" />
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Licenses_Card" Click="OnLicensesClick" IsClickEnabled="True">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8A5;" />
        </controls:SettingsCard.HeaderIcon>
      </controls:SettingsCard>
      <controls:SettingsCard x:Uid="Settings_Privacy_Card">
        <controls:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE72E;" />
        </controls:SettingsCard.HeaderIcon>
      </controls:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
