<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a tray (ADR-022): thumbnail or kind icon, name, size or the extension warning, format badge
     and "Entfernen". Replaces the old JobCardControl; the card frame is gone, the tray carries it now. -->
<UserControl
  x:Class="Kvertis.App.Views.TrayFileControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  IsTabStop="True"
  KeyDown="OnRowKeyDown"
  UseSystemFocusVisuals="True">

  <!-- The row itself (this control) takes focus and has its own automation peer, so the keyboard path
       runs tray head -> row -> row -> next tray head and a screen reader announces name and state.
       Delete removes the file, Enter carries on to step 2. -->
  <Grid Padding="4" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Preview. The thumbnail is a XAML image; the drawing surface never loads a user file (ADR-022). -->
    <Grid
      Grid.Column="0"
      Width="48"
      Height="48"
      VerticalAlignment="Top"
      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
      CornerRadius="6">
      <Image
        AutomationProperties.AccessibilityView="Raw"
        Source="{x:Bind Item.Thumbnail, Mode=OneWay}"
        Stretch="UniformToFill"
        Visibility="{x:Bind helpers:Ui.Show(Item.HasThumbnail), Mode=OneWay}" />
      <FontIcon
        FontSize="20"
        Glyph="{x:Bind Item.KindGlyph, Mode=OneWay}"
        Visibility="{x:Bind helpers:Ui.Hide(Item.HasThumbnail), Mode=OneWay}" />
    </Grid>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <TextBlock
        Style="{StaticResource BodyStrongTextBlockStyle}"
        Text="{x:Bind Item.FileName, Mode=OneWay}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Style="{StaticResource SecondaryCaptionTextStyle}"
        Text="{x:Bind Item.SizeText, Mode=OneWay}"
        Visibility="{x:Bind helpers:Ui.Hide(Item.HasMismatch), Mode=OneWay}" />
      <!-- The extension lies about the content: this replaces the size, because it matters more. -->
      <StackPanel
        Orientation="Horizontal"
        Spacing="4"
        Visibility="{x:Bind helpers:Ui.Show(Item.HasMismatch), Mode=OneWay}">
        <FontIcon FontSize="12" Foreground="{ThemeResource KvVideoBrush}" Glyph="&#xE7BA;" />
        <TextBlock
          Style="{StaticResource CaptionTextBlockStyle}"
          Text="{x:Bind Item.MismatchText, Mode=OneWay}"
          TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
        Style="{StaticResource CaptionTextBlockStyle}"
        Text="{x:Bind Item.WarningText, Mode=OneWay}"
        TextWrapping="Wrap"
        Visibility="{x:Bind helpers:Ui.ShowText(Item.WarningText), Mode=OneWay}" />
    </StackPanel>

    <Border
      Grid.Column="2"
      Padding="6,1"
      VerticalAlignment="Center"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4">
      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Item.InputFormatLabel, Mode=OneWay}" />
    </Border>

    <Button
      x:Uid="Card_Remove_Button"
      Grid.Column="3"
      Width="{StaticResource IconButtonSize}"
      Height="{StaticResource IconButtonSize}"
      VerticalAlignment="Center"
      Padding="0"
      Command="{x:Bind Item.RemoveCommand, Mode=OneWay}"
      Visibility="{x:Bind helpers:Ui.Show(Item.CanRemove), Mode=OneWay}">
      <FontIcon FontSize="14" Glyph="&#xE74D;" />
    </Button>
  </Grid>
</UserControl>
