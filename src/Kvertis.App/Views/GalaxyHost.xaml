<?xml version="1.0" encoding="utf-8"?>
<!-- The top area of step 1 (ADR-022): the galaxy plus everything that lies on top of it as XAML. The single
     place that decides what is drawn at all - moving surface, still picture, or nothing in high contrast. -->
<UserControl
  x:Class="Kvertis.App.Views.GalaxyHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers"
  xmlns:vm="using:Kvertis.App.ViewModels">

  <Grid>
    <!-- The drawing surface (or the still picture) is put in here by the code behind. -->
    <Grid x:Name="SurfaceLayer" AutomationProperties.AccessibilityView="Raw" />

    <!-- Empty round: the drop line stands in the middle of the empty galaxy, where it covers no orbit. -->
    <Border
      x:Name="EntryCard"
      Padding="16,10"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="{ThemeResource KvGlasBrush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Visibility="{x:Bind helpers:Ui.ShowUnless(ViewModel.ShowEmptyState, ViewModel.IsZoomed), Mode=OneWay}">
      <StackPanel HorizontalAlignment="Center" Spacing="6">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="16" Glyph="&#xE898;" />
          <TextBlock
            x:Uid="Galaxy_Entry_Title"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
          <Button x:Uid="Main_AddFiles_Button" Command="{x:Bind ViewModel.AddFilesCommand}" />
          <HyperlinkButton x:Uid="Main_AddFolder_Link" Command="{x:Bind ViewModel.AddFolderCommand}" />
        </StackPanel>
        <TextBlock
          x:Uid="Galaxy_Entry_PasteHint"
          HorizontalAlignment="Center"
          Style="{StaticResource SecondaryCaptionTextStyle}" />
      </StackPanel>
    </Border>

    <!-- Once files are in, the same two ways in stay reachable as one quiet line at the foot of the galaxy,
         so nothing covers the orbits any more. -->
    <Border
      x:Name="EntryBar"
      Margin="0,0,0,4"
      Padding="10,4"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      Background="{ThemeResource KvGlasBrush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="1"
      CornerRadius="6"
      Visibility="{x:Bind helpers:Ui.ShowUnless(ViewModel.HasJobs, ViewModel.IsZoomed), Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE898;" />
        <Button x:Uid="Main_AddFiles_Button" Command="{x:Bind ViewModel.AddFilesCommand}" />
        <HyperlinkButton x:Uid="Main_AddFolder_Link" Command="{x:Bind ViewModel.AddFolderCommand}" />
        <TextBlock
          x:Uid="Galaxy_Entry_PasteHint"
          VerticalAlignment="Center"
          Style="{StaticResource SecondaryCaptionTextStyle}" />
      </StackPanel>
    </Border>

    <!-- "Nicht umwandelbar": name and reason per file, at most three rows. -->
    <Border
      x:Name="RejectedCard"
      MaxWidth="300"
      Margin="0,8,8,0"
      Padding="12,8"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="{ThemeResource KvGlasBrush}"
      BorderBrush="{ThemeResource KvErrorBrush}"
      BorderThickness="1"
      CornerRadius="8"
      SizeChanged="OnRejectedCardSizeChanged"
      Visibility="{x:Bind helpers:Ui.ShowUnless(ViewModel.Rejected.HasAny, ViewModel.IsZoomed), Mode=OneWay}">
      <StackPanel Spacing="6">
        <TextBlock
          x:Uid="Galaxy_Rejected_Title"
          AutomationProperties.LiveSetting="Assertive"
          Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Rejected.Visible, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JobItemViewModel">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FileName}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Foreground="{ThemeResource KvMutedBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ErrorTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Button
                  x:Uid="Card_Remove_Button"
                  Grid.Column="1"
                  Width="{StaticResource IconButtonSize}"
                  Height="{StaticResource IconButtonSize}"
                  VerticalAlignment="Top"
                  Padding="0"
                  Command="{x:Bind RemoveCommand}">
                  <FontIcon FontSize="12" Glyph="&#xE74D;" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <HyperlinkButton
          AutomationProperties.Name="{x:Bind ViewModel.Rejected.MoreText, Mode=OneWay}"
          Command="{x:Bind ViewModel.Rejected.ToggleExpandCommand}"
          Content="{x:Bind ViewModel.Rejected.MoreText, Mode=OneWay}"
          Visibility="{x:Bind helpers:Ui.Show(ViewModel.Rejected.HasMore), Mode=OneWay}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
