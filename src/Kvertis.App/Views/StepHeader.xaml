<?xml version="1.0" encoding="utf-8"?>
<!-- The red thread above the content (.faden of design/oberflaeche-mischentwurf.html): three nodes with a square mark,
     title and a small status line, joined by segments that fill in mint up to the current step. The state is also
     in the glyph (number, check mark), in the visible status line and in AutomationProperties.ItemStatus, never
     in colour alone. -->
<UserControl
  x:Class="Kvertis.App.Views.StepHeader"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- .knoten: grid 28 | auto, gap 10, padding 7 12 7 8, radius 10, hover KvHover, disabled 0.5 (ghost template). -->
    <Style x:Key="StepNodeButtonStyle" TargetType="Button" BasedOn="{StaticResource KvGhostButtonStyle}">
      <Setter Property="Padding" Value="8,7,12,7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <Border
    x:Name="HeaderRoot"
    Height="62"
    Padding="22,0"
    Background="{ThemeResource KvPanel35Brush}"
    BorderBrush="{ThemeResource KvLineBrush}"
    BorderThickness="0,0,0,1">

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="DropStates">
        <VisualState x:Name="DropUpcoming">
          <VisualState.Setters>
            <Setter Target="DropMark.Background" Value="Transparent" />
            <Setter Target="DropMark.BorderBrush" Value="{ThemeResource KvLineStrongBrush}" />
            <Setter Target="DropNumber.Visibility" Value="Visible" />
            <Setter Target="DropNumber.Foreground" Value="{ThemeResource KvMutedBrush}" />
            <Setter Target="DropCheck.Visibility" Value="Collapsed" />
            <Setter Target="DropSocket.Visibility" Value="Collapsed" />
            <Setter Target="DropStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="DropCurrent">
          <VisualState.Setters>
            <Setter Target="DropMark.Background" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="DropMark.BorderBrush" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="DropNumber.Visibility" Value="Visible" />
            <Setter Target="DropNumber.Foreground" Value="{ThemeResource KvOnMintBrush}" />
            <Setter Target="DropCheck.Visibility" Value="Collapsed" />
            <Setter Target="DropSocket.Visibility" Value="Visible" />
            <Setter Target="DropStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="DropDone">
          <VisualState.Setters>
            <Setter Target="DropMark.Background" Value="{ThemeResource KvMintSurfaceBrush}" />
            <Setter Target="DropMark.BorderBrush" Value="{ThemeResource KvMintFrameBrush}" />
            <Setter Target="DropNumber.Visibility" Value="Collapsed" />
            <Setter Target="DropCheck.Visibility" Value="Visible" />
            <Setter Target="DropSocket.Visibility" Value="Collapsed" />
            <Setter Target="DropStatus.Foreground" Value="{ThemeResource KvMintBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="TargetStates">
        <VisualState x:Name="TargetUpcoming">
          <VisualState.Setters>
            <Setter Target="TargetMark.Background" Value="Transparent" />
            <Setter Target="TargetMark.BorderBrush" Value="{ThemeResource KvLineStrongBrush}" />
            <Setter Target="TargetNumber.Visibility" Value="Visible" />
            <Setter Target="TargetNumber.Foreground" Value="{ThemeResource KvMutedBrush}" />
            <Setter Target="TargetCheck.Visibility" Value="Collapsed" />
            <Setter Target="TargetSocket.Visibility" Value="Collapsed" />
            <Setter Target="TargetStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TargetCurrent">
          <VisualState.Setters>
            <Setter Target="TargetMark.Background" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="TargetMark.BorderBrush" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="TargetNumber.Visibility" Value="Visible" />
            <Setter Target="TargetNumber.Foreground" Value="{ThemeResource KvOnMintBrush}" />
            <Setter Target="TargetCheck.Visibility" Value="Collapsed" />
            <Setter Target="TargetSocket.Visibility" Value="Visible" />
            <Setter Target="TargetStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TargetDone">
          <VisualState.Setters>
            <Setter Target="TargetMark.Background" Value="{ThemeResource KvMintSurfaceBrush}" />
            <Setter Target="TargetMark.BorderBrush" Value="{ThemeResource KvMintFrameBrush}" />
            <Setter Target="TargetNumber.Visibility" Value="Collapsed" />
            <Setter Target="TargetCheck.Visibility" Value="Visible" />
            <Setter Target="TargetSocket.Visibility" Value="Collapsed" />
            <Setter Target="TargetStatus.Foreground" Value="{ThemeResource KvMintBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ConvertStates">
        <VisualState x:Name="ConvertUpcoming">
          <VisualState.Setters>
            <Setter Target="ConvertMark.Background" Value="Transparent" />
            <Setter Target="ConvertMark.BorderBrush" Value="{ThemeResource KvLineStrongBrush}" />
            <Setter Target="ConvertNumber.Visibility" Value="Visible" />
            <Setter Target="ConvertNumber.Foreground" Value="{ThemeResource KvMutedBrush}" />
            <Setter Target="ConvertCheck.Visibility" Value="Collapsed" />
            <Setter Target="ConvertSocket.Visibility" Value="Collapsed" />
            <Setter Target="ConvertStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ConvertCurrent">
          <VisualState.Setters>
            <Setter Target="ConvertMark.Background" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="ConvertMark.BorderBrush" Value="{ThemeResource KvMintBrush}" />
            <Setter Target="ConvertNumber.Visibility" Value="Visible" />
            <Setter Target="ConvertNumber.Foreground" Value="{ThemeResource KvOnMintBrush}" />
            <Setter Target="ConvertCheck.Visibility" Value="Collapsed" />
            <Setter Target="ConvertSocket.Visibility" Value="Visible" />
            <Setter Target="ConvertStatus.Foreground" Value="{ThemeResource KvQuietBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ConvertDone">
          <VisualState.Setters>
            <Setter Target="ConvertMark.Background" Value="{ThemeResource KvMintSurfaceBrush}" />
            <Setter Target="ConvertMark.BorderBrush" Value="{ThemeResource KvMintFrameBrush}" />
            <Setter Target="ConvertNumber.Visibility" Value="Collapsed" />
            <Setter Target="ConvertCheck.Visibility" Value="Visible" />
            <Setter Target="ConvertSocket.Visibility" Value="Collapsed" />
            <Setter Target="ConvertStatus.Foreground" Value="{ThemeResource KvMintBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Step 1 -->
      <Button
        x:Name="DropButton"
        x:Uid="Steps_Drop_Button"
        Grid.Column="0"
        Style="{StaticResource StepNodeButtonStyle}"
        Click="OnDropClick">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- The square mark; the socket lies 3 px below it and only shows on the current step. -->
          <Grid Grid.RowSpan="2" Width="28" Height="28" VerticalAlignment="Center">
            <Border
              x:Name="DropSocket"
              Margin="0,3,0,-3"
              Background="{ThemeResource KvMintDark45Brush}"
              CornerRadius="9"
              Visibility="Collapsed" />
            <Border x:Name="DropMark" BorderThickness="1" CornerRadius="9">
              <Grid>
                <TextBlock
                  x:Name="DropNumber"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Style="{StaticResource KvMonoTextStyle}" />
                <FontIcon
                  x:Name="DropCheck"
                  FontSize="12"
                  Foreground="{ThemeResource KvMintBrush}"
                  Glyph="&#xE73E;"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
          </Grid>
          <TextBlock
            x:Name="DropLabel"
            x:Uid="Steps_Drop_Label"
            Grid.Column="1"
            FontSize="13"
            LineHeight="20"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvHeadTextStyle}" />
          <TextBlock
            x:Name="DropStatus"
            Grid.Row="1"
            Grid.Column="1"
            FontSize="11"
            LineHeight="17"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvMonoTextStyle}" />
        </Grid>
      </Button>

      <!-- Segment: line-stark track, mint fill that grows from the left (composition scale, see code-behind). -->
      <Grid
        Grid.Column="1"
        Height="2"
        Margin="6,0"
        VerticalAlignment="Center"
        Background="{ThemeResource KvLineStrongBrush}"
        CornerRadius="1">
        <Rectangle x:Name="DropSegmentFill" Fill="{ThemeResource KvMintBrush}" />
      </Grid>

      <!-- Step 2 -->
      <Button
        x:Name="TargetButton"
        x:Uid="Steps_Target_Button"
        Grid.Column="2"
        Style="{StaticResource StepNodeButtonStyle}"
        Click="OnTargetClick">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- The square mark; the socket lies 3 px below it and only shows on the current step. -->
          <Grid Grid.RowSpan="2" Width="28" Height="28" VerticalAlignment="Center">
            <Border
              x:Name="TargetSocket"
              Margin="0,3,0,-3"
              Background="{ThemeResource KvMintDark45Brush}"
              CornerRadius="9"
              Visibility="Collapsed" />
            <Border x:Name="TargetMark" BorderThickness="1" CornerRadius="9">
              <Grid>
                <TextBlock
                  x:Name="TargetNumber"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Style="{StaticResource KvMonoTextStyle}" />
                <FontIcon
                  x:Name="TargetCheck"
                  FontSize="12"
                  Foreground="{ThemeResource KvMintBrush}"
                  Glyph="&#xE73E;"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
          </Grid>
          <TextBlock
            x:Name="TargetLabel"
            x:Uid="Steps_Target_Label"
            Grid.Column="1"
            FontSize="13"
            LineHeight="20"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvHeadTextStyle}" />
          <TextBlock
            x:Name="TargetStatus"
            Grid.Row="1"
            Grid.Column="1"
            FontSize="11"
            LineHeight="17"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvMonoTextStyle}" />
        </Grid>
      </Button>

      <!-- Segment: line-stark track, mint fill that grows from the left (composition scale, see code-behind). -->
      <Grid
        Grid.Column="3"
        Height="2"
        Margin="6,0"
        VerticalAlignment="Center"
        Background="{ThemeResource KvLineStrongBrush}"
        CornerRadius="1">
        <Rectangle x:Name="TargetSegmentFill" Fill="{ThemeResource KvMintBrush}" />
      </Grid>

      <!-- Step 3 -->
      <Button
        x:Name="ConvertButton"
        x:Uid="Steps_Convert_Button"
        Grid.Column="4"
        Style="{StaticResource StepNodeButtonStyle}"
        Click="OnConvertClick">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- The square mark; the socket lies 3 px below it and only shows on the current step. -->
          <Grid Grid.RowSpan="2" Width="28" Height="28" VerticalAlignment="Center">
            <Border
              x:Name="ConvertSocket"
              Margin="0,3,0,-3"
              Background="{ThemeResource KvMintDark45Brush}"
              CornerRadius="9"
              Visibility="Collapsed" />
            <Border x:Name="ConvertMark" BorderThickness="1" CornerRadius="9">
              <Grid>
                <TextBlock
                  x:Name="ConvertNumber"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Style="{StaticResource KvMonoTextStyle}" />
                <FontIcon
                  x:Name="ConvertCheck"
                  FontSize="12"
                  Foreground="{ThemeResource KvMintBrush}"
                  Glyph="&#xE73E;"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
          </Grid>
          <TextBlock
            x:Name="ConvertLabel"
            x:Uid="Steps_Convert_Label"
            Grid.Column="1"
            FontSize="13"
            LineHeight="20"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvHeadTextStyle}" />
          <TextBlock
            x:Name="ConvertStatus"
            Grid.Row="1"
            Grid.Column="1"
            FontSize="11"
            LineHeight="17"
            LineStackingStrategy="BlockLineHeight"
            Style="{StaticResource KvMonoTextStyle}" />
        </Grid>
      </Button>
    </Grid>
  </Border>
</UserControl>
