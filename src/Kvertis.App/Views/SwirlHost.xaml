<?xml version="1.0" encoding="utf-8"?>
<!-- The stage of step 3 (ADR-023, draft .w5-buehne): the swirl surface plus everything that lies on top of it as
     XAML. The single place that decides what is drawn at all - moving surface, static ring after the round, or only
     the cards in high contrast. With the moving surface the running files show only in the swirl and in the list
     (draft); without it the compact progress cards stand in the middle. The report card is XAML in every mode. -->
<UserControl
  x:Class="Kvertis.App.Views.SwirlHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:convert="using:Kvertis.App.ViewModels.Convert"
  xmlns:helpers="using:Kvertis.App.Helpers">

  <UserControl.Resources>
    <!-- A running file with its progress; only shown without the drawing surface -->
    <DataTemplate x:Key="SwirlRowTemplate" x:DataType="convert:ConvertRowViewModel">
      <Border
        MinWidth="220"
        MaxWidth="320"
        Margin="0,0,0,6"
        Style="{StaticResource KvRowStyle}"
        Padding="12,7">
        <StackPanel AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" Spacing="4">
          <TextBlock Style="{StaticResource KvRowTextStyle}" Text="{x:Bind FileName}" />
          <ProgressBar
            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
            Foreground="{x:Bind helpers:Ui.Brush(ColorBrushKey)}"
            IsIndeterminate="False"
            Maximum="100"
            Minimum="0"
            Value="{x:Bind ProgressValue, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Style="{StaticResource KvMonoTextStyle}" Text="{x:Bind FormatsText}" />
            <TextBlock Style="{StaticResource KvMonoTextStyle}" Text="{x:Bind PercentText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource KvMonoTextStyle}" Text="{x:Bind RemainingText, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- .w5-bericht span.fehl -->
    <DataTemplate x:Key="FailureLineTemplate" x:DataType="x:String">
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="11.5"
        FontWeight="Normal"
        Foreground="{ThemeResource KvErrorBrush}"
        Style="{StaticResource KvMonoTextStyle}"
        Text="{x:Bind}"
        TextAlignment="Center"
        TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" Background="Transparent">
    <!-- The drawing surface (or the static ring) is put in here by the code behind. -->
    <Grid x:Name="SurfaceLayer" AutomationProperties.AccessibilityView="Raw" />

    <!-- Without the surface: what will happen, then the running files (the swirl shows them otherwise) -->
    <StackPanel
      x:Name="StatusStack"
      Margin="16,20,16,12"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Spacing="6"
      Visibility="Collapsed">
      <TextBlock
        HorizontalAlignment="Center"
        Style="{StaticResource KvSmallTextStyle}"
        Text="{x:Bind ViewModel.SwirlHintText, Mode=OneWay}"
        TextAlignment="Center"
        Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowSwirlHint), Mode=OneWay}" />
      <ItemsRepeater x:Name="RowsRepeater" ItemTemplate="{StaticResource SwirlRowTemplate}" ItemsSource="{x:Bind ViewModel.Swirl}" />
      <TextBlock
        HorizontalAlignment="Center"
        Style="{StaticResource KvSmallTextStyle}"
        Text="{x:Bind ViewModel.SwirlMoreText, Mode=OneWay}"
        Visibility="{x:Bind helpers:Ui.ShowText(ViewModel.SwirlMoreText), Mode=OneWay}" />
    </StackPanel>

    <!-- Closing report: centred inside the ring (draft: #w5-bericht, top 128, width min(440, 90 %), gap 3) -->
    <StackPanel
      x:Name="ReportCard"
      MaxWidth="440"
      Margin="24,128,24,12"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      DataContext="{x:Bind ViewModel.Report, Mode=OneWay}"
      Spacing="3"
      Visibility="{x:Bind helpers:Ui.Show(ViewModel.ShowReportCard), Mode=OneWay}">
      <TextBlock
        HorizontalAlignment="Center"
        AutomationProperties.HeadingLevel="Level2"
        AutomationProperties.LiveSetting="Assertive"
        CharacterSpacing="-10"
        FontSize="18"
        FontWeight="SemiBold"
        Style="{StaticResource KvTextBaseStyle}"
        Text="{Binding TitleText}"
        TextAlignment="Center"
        TextTrimming="None"
        TextWrapping="Wrap" />
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="11.5"
        FontWeight="Normal"
        Style="{StaticResource KvMonoTextStyle}"
        Text="{Binding SummaryText}"
        TextAlignment="Center"
        TextWrapping="Wrap" />
      <ItemsControl HorizontalAlignment="Center" ItemTemplate="{StaticResource FailureLineTemplate}" ItemsSource="{Binding Failures}" />
      <StackPanel
        Margin="0,8,0,0"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Spacing="8">
        <Button
          x:Uid="Convert_Report_OpenFolder_Button"
          Command="{Binding OpenFolderCommand}"
          IsEnabled="{Binding CanOpenFolder}"
          Style="{StaticResource KvSmallOutlineMintButtonStyle}" />
        <Button
          x:Uid="Convert_NewRound_Button"
          Command="{x:Bind ViewModel.NewRoundCommand}"
          Style="{StaticResource KvSmallButtonStyle}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
