<?xml version="1.0" encoding="utf-8"?>
<!-- The Win2D surface of step 1 (ADR-022). Decorative only: it is not in the tab order and screen readers
     never see it; every piece of information it shows also stands in the trays next to it. -->
<UserControl
  x:Class="Kvertis.App.Rendering.GalaxyCanvas"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  AutomationProperties.AccessibilityView="Raw"
  IsTabStop="False">

  <!-- The scene only knows plain RGB values. These brushes carry the theme's Kv* colours to
       ScenePaletteReader, which re-reads them whenever ActualTheme changes. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="SceneColor_Image" Color="{ThemeResource KvImageColor}" />
    <SolidColorBrush x:Key="SceneColor_Audio" Color="{ThemeResource KvAudioColor}" />
    <SolidColorBrush x:Key="SceneColor_Video" Color="{ThemeResource KvVideoColor}" />
    <SolidColorBrush x:Key="SceneColor_Document" Color="{ThemeResource KvDocumentColor}" />
    <SolidColorBrush x:Key="SceneColor_Model3D" Color="{ThemeResource KvModelColor}" />
    <SolidColorBrush x:Key="SceneColor_Mint" Color="{ThemeResource KvMintColor}" />
    <SolidColorBrush x:Key="SceneColor_Error" Color="{ThemeResource KvErrorColor}" />
    <SolidColorBrush x:Key="SceneColor_Ink" Color="{ThemeResource KvInkColor}" />
    <SolidColorBrush x:Key="SceneColor_Background" Color="{ThemeResource KvBackgroundColor}" />
    <SolidColorBrush x:Key="SceneColor_Muted" Color="{ThemeResource KvMutedColor}" />
  </UserControl.Resources>

  <Grid
    x:Name="SurfaceHost"
    Background="Transparent"
    PointerExited="OnPointerExited"
    PointerMoved="OnPointerMoved"
    SizeChanged="OnSurfaceSizeChanged"
    Tapped="OnSurfaceTapped" />
</UserControl>
