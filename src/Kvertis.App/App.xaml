<?xml version="1.0" encoding="utf-8"?>
<Application
  x:Class="Kvertis.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:helpers="using:Kvertis.App.Helpers">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- After XamlControlsResources on purpose: the Kvertis tokens override the WinUI accent resources
             (ADR-017). Merged dictionaries are searched from last to first. -->
        <ResourceDictionary Source="ms-appx:///Themes/KvertisColors.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Cards (docs/06-design.md, "Farben und Material"): theme brushes only, so high contrast works. -->
      <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,16,0,8" />
      </Style>

      <Style x:Key="SecondaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <x:Double x:Key="IconButtonSize">32</x:Double>

      <!-- Only for classic bindings whose data context can be null (step 2); x:Bind uses helpers:Ui. -->
      <helpers:ShowConverter x:Key="ShowConverter" />
      <helpers:BrushKeyConverter x:Key="BrushKeyConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
