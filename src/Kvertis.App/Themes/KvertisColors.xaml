      <SolidColorBrush x:Key="KvDeepBrush" Color="{ThemeResource KvDeepColor}" />
      <SolidColorBrush x:Key="KvLineBrush" Color="{ThemeResource KvLineColor}" />
      <SolidColorBrush x:Key="KvLineStrongBrush" Color="{ThemeResource KvLineStrongColor}" />
      <SolidColorBrush x:Key="KvInkBrush" Color="{ThemeResource KvInkColor}" />
      <SolidColorBrush x:Key="KvMutedBrush" Color="{ThemeResource KvMutedColor}" />
