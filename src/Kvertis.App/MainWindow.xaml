<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Kvertis.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:rendering="using:Kvertis.App.Rendering"
  xmlns:views="using:Kvertis.App.Views">

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar (.tb of the draft): panel 55 % over Mica, 1 px line below. Only AppTitleBar is the drag
         region; the buttons stay clickable. The row stays 48 high for the system caption buttons. -->
    <Grid
      x:Name="TitleBarGrid"
      Grid.Row="0"
      Background="{ThemeResource KvPanel55Brush}"
      BorderBrush="{ThemeResource KvLineBrush}"
      BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CaptionButtonsColumn" Width="140" />
      </Grid.ColumnDefinitions>

      <Button
        x:Name="BackButton"
        x:Uid="Window_Back_Button"
        Grid.Column="0"
        Margin="8,0,0,0"
        Style="{StaticResource KvIconButtonStyle}"
        Visibility="Collapsed"
        Click="OnBackClick">
        <FontIcon FontSize="14" Glyph="&#xE72B;" />
      </Button>

      <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
          <Image Width="20" Height="20" Source="ms-appx:///Assets/Square44x44Logo.png" />
          <TextBlock
            x:Uid="Window_Title_Text"
            VerticalAlignment="Center"
            FontSize="13"
            Style="{StaticResource KvHeadTextStyle}" />
        </StackPanel>
      </Grid>

      <StackPanel
        Grid.Column="2"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="4">
        <Button
          x:Name="HistoryButton"
          x:Uid="Window_History_Button"
          Style="{StaticResource KvIconButtonStyle}"
          Click="OnHistoryClick">
          <FontIcon FontSize="16" Glyph="&#xE81C;" />
        </Button>
        <Button
          x:Name="SettingsButton"
          x:Uid="Window_Settings_Button"
          Style="{StaticResource KvIconButtonStyle}"
          Click="OnSettingsClick">
          <FontIcon FontSize="16" Glyph="&#xE713;" />
        </Button>
        <!-- The .pro badge; the button around it stays clickable (Pro page). The free/active status is the tooltip. -->
        <Button
          x:Name="ProButton"
          x:Uid="Window_Pro_Button"
          Height="32"
          Margin="2,0,0,0"
          Padding="4,0"
          Style="{StaticResource KvGhostButtonStyle}"
          Click="OnProClick">
          <ToolTipService.ToolTip>
            <TextBlock x:Name="ProStatusText" />
          </ToolTipService.ToolTip>
          <Border Style="{StaticResource KvProBadgeStyle}">
            <TextBlock x:Uid="Window_Pro_Badge" Style="{StaticResource KvProBadgeTextStyle}" />
          </Border>
        </Button>
      </StackPanel>
    </Grid>

    <!-- The three steps, only on the pages of the main path; the control hides itself elsewhere. -->
    <views:StepHeader x:Name="StepHeaderControl" Grid.Row="1" />

    <Frame x:Name="ContentFrame" Grid.Row="2" />

    <!-- The drawn step transitions (ADR-023) fly over the step header and the frame. Transparent and paused
         while idle, never a target for input or the narrator. -->
    <rendering:TransitionOverlay
      x:Name="TransitionOverlayControl"
      Grid.Row="1"
      Grid.RowSpan="2" />
  </Grid>
</Window>
